@using ApexCharts
@using MudBlazor
@inject TemperatureStore Store
@inject MonitorOptions Options

<MudPaper Class="pa-3 chart-card room-single-charts">
    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap" Class="mb-2">
        <MudText Typo="Typo.h6">
            <i class="fa-solid fa-chart-area" aria-hidden="true"></i> @RoomName — history
        </MudText>
        <MudButton Variant="Variant.Text"
                   Color="MudBlazor.Color.Primary"
                   Size="MudBlazor.Size.Small"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   Href="/charts">
            All charts
        </MudButton>
    </MudStack>
    <MudText Typo="Typo.caption" Class="mud-text-secondary mb-3 d-block">
        Hover to compare all lines at one time; drag across a chart to zoom. Shaded spans are when heating was off.
    </MudText>

    <MudGrid Spacing="2" Class="mb-3">
        <MudItem xs="12" sm="6" md="4">
            <MudSelect T="int"
                       Label="Window"
                       Value="_hours"
                       ValueChanged="OnHoursChanged"
                       Variant="Variant.Outlined"
                       Dense="true"
                       Margin="Margin.Dense"
                       Class="touch-control">
                <MudSelectItem Value="12">12 hours</MudSelectItem>
                <MudSelectItem Value="24">24 hours</MudSelectItem>
                <MudSelectItem Value="48">48 hours</MudSelectItem>
                <MudSelectItem Value="72">72 hours</MudSelectItem>
                <MudSelectItem Value="168">7 days</MudSelectItem>
            </MudSelect>
        </MudItem>
        <MudItem xs="12" sm="6" md="4">
            <MudSwitch T="bool"
                       Label="Outdoor series"
                       Value="_includeOutdoor"
                       ValueChanged="OnOutdoorChanged"
                       Color="MudBlazor.Color.Primary"
                       Class="mt-sm-4"
                       Disabled="@(Options.OpenMeteoLat is null)" />
        </MudItem>
    </MudGrid>

    @if (string.IsNullOrWhiteSpace(RoomName))
    {
        <MudAlert Severity="Severity.Info" Dense="true">No room selected.</MudAlert>
    }
    else if (_data is null)
    {
        <MudAlert Severity="Severity.Info" Dense="true">No stored samples for this room in the selected window.</MudAlert>
    }
    else
    {
        <MudText Typo="Typo.subtitle2" Class="mb-1">Room temperature &amp; target (°C)</MudText>
        <div class="room-apex-chart" @key="@($"t-{_renderKey}")">
            <ApexChart TItem="ChartPoint"
                       Options="_tempOptions"
                       XAxisType="XAxisType.Datetime"
                       Height="@("300")">
                <ApexPointSeries TItem="ChartPoint"
                                 Items="_data.Room"
                                 Name="@SeriesRoom"
                                 SeriesType="SeriesType.Line"
                                 XValue="p => p.X"
                                 YValue="p => p.Y"
                                 Color="@ColorRoom" />
                @if (_data.HasTarget)
                {
                    <ApexPointSeries TItem="ChartPoint"
                                     Items="_data.Target"
                                     Name="@SeriesTarget"
                                     SeriesType="SeriesType.Line"
                                     XValue="p => p.X"
                                     YValue="p => p.Y"
                                     Color="@ColorTarget" />
                }
                @if (_showOutdoor)
                {
                    <ApexPointSeries TItem="ChartPoint"
                                     Items="_data.Outdoor"
                                     Name="@SeriesOutdoor"
                                     SeriesType="SeriesType.Line"
                                     XValue="p => p.X"
                                     YValue="p => p.Y"
                                     Color="@ColorOutdoor" />
                }
            </ApexChart>
        </div>

        <MudText Typo="Typo.subtitle2" Class="mb-1 mt-3">Valve demand (%)</MudText>
        @if (!_data.HasValve)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-0">
                No valve percentage samples in this window.
            </MudAlert>
        }
        else
        {
            <div class="room-apex-chart" @key="@($"v-{_renderKey}")">
                <ApexChart TItem="ChartPoint"
                           Options="_valveOptions"
                           XAxisType="XAxisType.Datetime"
                           Height="@("170")">
                    <ApexPointSeries TItem="ChartPoint"
                                     Items="_data.Valve"
                                     Name="@SeriesValve"
                                     SeriesType="SeriesType.Area"
                                     XValue="p => p.X"
                                     YValue="p => p.Y"
                                     Color="@ColorValve" />
                </ApexChart>
            </div>
        }
    }
</MudPaper>

@code {
    [Parameter] public string RoomName { get; set; } = "";

    private const string SeriesRoom = "Room";
    private const string SeriesTarget = "Target";
    private const string SeriesOutdoor = "Outdoor";
    private const string SeriesValve = "Valve demand";

    private const string ColorRoom = "#3b82f6";
    private const string ColorTarget = "#f59e0b";
    private const string ColorOutdoor = "#14b8a6";
    private const string ColorValve = "#ef4444";

    // Shared tooltip: temperatures to 1 dp; a gap in the target line means heating was off.
    private const string TempTooltipFormatter =
        "function(value, opts) {" +
        " if (value === null || value === undefined || isNaN(value)) {" +
        "  var name = opts && opts.w ? opts.w.globals.seriesNames[opts.seriesIndex] : '';" +
        "  return name === 'Target' ? 'Off' : '—'; }" +
        " return Number(value).toFixed(1) + ' °C'; }";

    private const string TempAxisFormatter = "function(value) { return Number(value).toFixed(0) + '°'; }";
    private const string ValveTooltipFormatter = "function(value) { return value === null || value === undefined ? '—' : Math.round(value) + ' %'; }";
    private const string ValveAxisFormatter = "function(value) { return Math.round(value) + '%'; }";

    private int _hours = 24;
    private bool _includeOutdoor = true;
    private int _renderKey;
    private string _lastLoadedRoom = string.Empty;
    private RoomHistoryChartBuilder.Result? _data;
    private ApexChartOptions<ChartPoint> _tempOptions = new();
    private ApexChartOptions<ChartPoint> _valveOptions = new();

    private bool _showOutdoor => _includeOutdoor && _data is { HasOutdoor: true };
    private string ChartGroup => $"room-{_lastLoadedRoom}";

    private TimeZoneInfo DisplayZone => TimeZoneResolver.Resolve(Options.TimeZoneId);

    protected override void OnParametersSet()
    {
        var key = RoomName.Trim();
        if (!string.Equals(_lastLoadedRoom, key, StringComparison.OrdinalIgnoreCase))
        {
            _lastLoadedRoom = key;
            LoadData();
        }
    }

    private Task OnHoursChanged(int hours)
    {
        _hours = hours;
        LoadData();
        return Task.CompletedTask;
    }

    private Task OnOutdoorChanged(bool v)
    {
        _includeOutdoor = v;
        LoadData();
        return Task.CompletedTask;
    }

    private void LoadData()
    {
        _data = null;
        if (string.IsNullOrWhiteSpace(RoomName))
            return;

        var since = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - (_hours * 3600L);
        var rows = Store.SeriesRoom(RoomName.Trim(), since);
        var outdoor = _includeOutdoor && Options.OpenMeteoLat is not null
            ? Store.SeriesOutdoor(since)
            : null;

        _data = RoomHistoryChartBuilder.Build(rows, outdoor, DisplayZone);
        if (_data is null)
            return;

        _tempOptions = BuildTempOptions(_data);
        _valveOptions = BuildValveOptions();
        _renderKey++;
    }

    private ApexChartOptions<ChartPoint> BuildTempOptions(RoomHistoryChartBuilder.Result data)
    {
        var o = BaseOptions($"{ChartGroup}-temp");

        var curves = new List<Curve> { Curve.Smooth };
        var widths = new List<double> { 2.5 };
        var dashes = new List<double> { 0 };
        if (data.HasTarget)
        {
            curves.Add(Curve.Stepline);
            widths.Add(2);
            dashes.Add(0);
        }
        if (_showOutdoor)
        {
            curves.Add(Curve.Smooth);
            widths.Add(1.5);
            dashes.Add(5);
        }
        o.Stroke = new Stroke { Curve = curves, Width = widths, DashArray = dashes };

        o.Yaxis =
        [
            new YAxis
            {
                Min = data.YMin,
                Max = data.YMax,
                ForceNiceScale = false,
                TickAmount = data.YTickAmount,
                Labels = new YAxisLabels { Formatter = TempAxisFormatter, MinWidth = 36, MaxWidth = 36 },
            },
        ];
        o.Tooltip.Y = new TooltipY { Formatter = TempTooltipFormatter };

        o.Annotations = new Annotations
        {
            Xaxis = data.OffRanges
                .Select(r => new AnnotationsXAxis
                {
                    X = r.Start,
                    X2 = r.End,
                    FillColor = "#94a3b8",
                    Opacity = 0.12,
                    BorderColor = "transparent",
                })
                .ToList(),
        };
        return o;
    }

    private ApexChartOptions<ChartPoint> BuildValveOptions()
    {
        var o = BaseOptions($"{ChartGroup}-valve");
        o.Stroke = new Stroke { Curve = Curve.Straight, Width = 1.5 };
        o.Fill = new Fill
        {
            Type = FillType.Gradient,
            Gradient = new FillGradient { OpacityFrom = 0.45, OpacityTo = 0.05 },
        };
        o.Yaxis =
        [
            new YAxis
            {
                Min = 0,
                Max = 100,
                TickAmount = 2,
                Labels = new YAxisLabels { Formatter = ValveAxisFormatter, MinWidth = 36, MaxWidth = 36 },
            },
        ];
        o.Tooltip.Y = new TooltipY { Formatter = ValveTooltipFormatter };
        o.Legend = new Legend { Show = false };
        return o;
    }

    private ApexChartOptions<ChartPoint> BaseOptions(string id) => new()
    {
        Chart = new Chart
        {
            Id = id,
            Group = ChartGroup,
            Background = "transparent",
            FontFamily = "inherit",
            ForeColor = "#94a3b8", // readable on both themes even before app.css applies
            Animations = new Animations { Enabled = false },
            Toolbar = new Toolbar
            {
                Show = true,
                Tools = new Tools { Download = false, Pan = false, Selection = false, Zoom = true, Zoomin = true, Zoomout = true, Reset = true },
            },
            Zoom = new Zoom { Enabled = true, AutoScaleYaxis = false, AllowMouseWheelZoom = true },
        },
        Xaxis = new XAxis
        {
            Type = XAxisType.Datetime,
            Labels = new XAxisLabels
            {
                DatetimeUTC = true,
                HideOverlappingLabels = true,
                DatetimeFormatter = new DatetimeFormatter { Hour = "HH:mm", Day = "ddd d MMM" },
            },
            Tooltip = new XAxisTooltip { Enabled = false },
        },
        Tooltip = new Tooltip
        {
            Shared = true,
            Intersect = false,
            X = new TooltipX { Format = "ddd d MMM, HH:mm" },
        },
        Grid = new Grid { StrokeDashArray = 3, Padding = new Padding { Left = 8, Right = 8 } },
        Markers = new Markers { Size = 0, Hover = new MarkersHover { Size = 4 } },
        Legend = new Legend { Position = LegendPosition.Top, HorizontalAlign = ApexCharts.Align.Left },
        DataLabels = new DataLabels { Enabled = false },
    };
}
