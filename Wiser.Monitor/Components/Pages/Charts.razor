@page "/charts"
@rendermode InteractiveServer
@implements IAsyncDisposable
@using System.Globalization

@inject TemperatureStore Store
@inject MonitorOptions Options
@inject RoomsLiveDataCache RoomsCache
@inject IJSRuntime Js

<PageTitle>Wiser Monitor - Charts</PageTitle>

<MudStack Spacing="2">
    <MudPaper Class="pa-4 page-header-card" id="data-quality">
        <MudText Typo="Typo.h5">
            <i class="fa-solid fa-chart-line"></i> Charts
        </MudText>
        <MudText Typo="Typo.body2" Class="mt-1">
            Compare room temperature, target, valve demand, and optional outdoor data.
        </MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
            <MudTooltip Text="Sensor readings rejected in the last 24h (invalid scale, missing temp, etc.). Open Charts → Data quality for detail.">
                <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">
                    Dropped invalid readings (24h): @_qualityTotal24h
                </MudChip>
            </MudTooltip>
            @foreach (var rc in _qualityReasons24h)
            {
                <MudTooltip Text="Breakdown of why samples were dropped.">
                    <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">
                        @($"{rc.Reason}: {rc.Count}")
                    </MudChip>
                </MudTooltip>
            }
        </MudStack>
    </MudPaper>

    <MudTabs Rounded="true" Border="true" ApplyEffectsToContainer="true" Class="charts-page-tabs">
    <MudTabPanel Text="Overview" Icon="@Icons.Material.Filled.Dashboard">
    <MudStack Spacing="2">
    <MudPaper Class="pa-3 chart-card">
        <MudText Typo="Typo.h6" Class="mb-2">
            <i class="fa-solid fa-grip"></i> Current room temperatures and trend status
        </MudText>
        @if (_roomTiles.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No heatmap data yet.</MudAlert>
        }
        else
        {
            <div class="room-heat-grid">
                @foreach (var tile in _roomTiles)
                {
                    <a class="room-heat-tile room-heat-link"
                       style="background-color:@tile.Color;"
                       href="@GetRoomDetailsHref(tile.Room)"
                       title="@($"Open {tile.Room} in Rooms")">
                        <div class="room-heat-name">
                            <span class="room-heat-state-square" style="background-color:@tile.CurrentStateColor;" title="@tile.CurrentStateText"></span>
                            @tile.Room
                        </div>
                        <div class="room-heat-temp">
                            @tile.DisplayTemp
                        </div>
                        <div class="room-heat-meta">@tile.RangeText</div>
                        <div class="room-heat-meta">@tile.StatusText</div>
                        <div class="room-heat-meta">@tile.TrendText</div>
                    </a>
                }
            </div>
        }
    </MudPaper>

    <MudPaper Class="pa-3 chart-card" id="rooms-calling-heat-trend">
        <MudText Typo="Typo.h6" Class="mb-2">
            <i class="fa-solid fa-fire-flame-curved"></i> 24-hour temperature — rooms calling for heat
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">
            Same room set and history window as <strong>Selected room trend</strong>: measured °C and valve demand % where the hub reported it.
            Rooms qualify if they had valve/output demand or a poll with heating active (see daily <strong>Heat demand est. min</strong>).
            Time axis uses your configured display timezone, matching other charts.
        </MudText>
        @if (_heatCallingHasAnyPlottedSeries && _heatCallingRoomPickerNames.Count > 0)
        {
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-1">
                Tap a room to hide it from <strong>both</strong> charts below (outlined = hidden).
            </MudText>
            <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-3 align-center">
                @foreach (var name in _heatCallingRoomPickerNames)
                {
                    var hidden = _heatCallingHiddenRooms.Contains(name);
                    <MudChip T="string"
                             Text="@name"
                             Color="@(hidden ? Color.Default : Color.Primary)"
                             Variant="@(hidden ? Variant.Outlined : Variant.Filled)"
                             Icon="@(hidden ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                             OnClick="@(() => ToggleHeatCallingRoomVisibility(name))" />
                }
                @if (_heatCallingHiddenRooms.Count > 0)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="ClearHeatCallingHiddenRooms">
                        Show all
                    </MudButton>
                }
            </MudStack>
        }
        @if (!_heatCallingHasAnyPlottedSeries)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No qualifying rooms in the last 24 hours (no heating-active polls and no per-room demand), or no samples yet.
            </MudAlert>
        }
        else if (!HeatCallingAnyRoomVisible)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mb-0">
                All rooms are hidden. Tap a grey chip above to show one again, or <strong>Show all</strong>.
            </MudAlert>
        }
        else
        {
            @if (HeatCallingTempLines.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    No plottable room temperature in this window (check sensor data quality).
                </MudAlert>
            }
            else
            {
                var range = RoomHistoryChartBuilder.TemperatureRange(HeatCallingTempLines.Select(static l => l.Points).ToArray());
                <MudText Typo="Typo.subtitle2" Class="mb-1">Room temperature (°C)</MudText>
                <TimeLinesChart Id="heat-calling-temp"
                                Group="heat-calling"
                                Lines="HeatCallingTempLines"
                                Unit="°C"
                                Decimals="1"
                                YMin="range.Min"
                                YMax="range.Max"
                                YTickAmount="@((int)((range.Max - range.Min) / range.Step))"
                                Height="300"
                                ZoomState="_heatCallingZoom"
                                ResetKey="@HeatCallingResetKey" />
            }
            <MudText Typo="Typo.subtitle2" Class="mb-1 mt-3">Valve demand (%)</MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-1 d-block">
                Colours match the temperature chart. Rooms without valve % samples are left out.
            </MudText>
            @if (HeatCallingValveLines.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-0">
                    No valve percentage samples for the visible rooms in this window.
                </MudAlert>
            }
            else
            {
                <TimeLinesChart Id="heat-calling-valve"
                                Group="heat-calling"
                                Lines="HeatCallingValveLines"
                                Unit=" %"
                                Decimals="0"
                                YMin="0"
                                YMax="100"
                                YTickAmount="4"
                                Height="220"
                                ZoomState="_heatCallingZoom"
                                ResetKey="@HeatCallingResetKey" />
            }
        }
    </MudPaper>

    <MudGrid Spacing="2" Class="charts-two-col-row">
        <MudItem xs="12" md="6" Class="charts-grid-cell">
            <MudPaper Class="pa-3 chart-card charts-grid-paper">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <i class="fa-solid fa-gauge-high"></i> Per-room efficiency score
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Estimated as positive room temperature gain (°C) per boiler relay-on minute in the selected window.
                    Lower or negative values can indicate underperforming emitters or heat loss.
                </MudText>
                @if (_roomEfficiencyRows.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No efficiency rows yet.</MudAlert>
                }
                else
                {
                    <MudTable T="RoomEfficiencyRow" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Items="_roomEfficiencyRows">
                        <HeaderContent>
                            <MudTh>Room</MudTh>
                            <MudTh Class="text-right">Score (°C/min)</MudTh>
                            <MudTh Class="text-right">vs prev week</MudTh>
                            <MudTh Class="text-right">Temp gain (°C)</MudTh>
                            <MudTh Class="text-right">Relay min</MudTh>
                            <MudTh>Note</MudTh>
                            <MudTh>Review</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Room">
                                <MudLink Href="@GetRoomDetailsHref(context.Room)">@context.Room</MudLink>
                            </MudTd>
                            <MudTd DataLabel="Score" Class="text-right">@Fmt(context.ScoreCPerRelayMinute)</MudTd>
                            <MudTd DataLabel="vs prev week" Class="text-right">@FormatEfficiencyTrend(context.WeeklyDeltaCPerRelayMinute)</MudTd>
                            <MudTd DataLabel="Temp gain" Class="text-right">@Fmt(context.PositiveTempGainC)</MudTd>
                            <MudTd DataLabel="Relay min" Class="text-right">@Fmt(context.RelayMinutes)</MudTd>
                            <MudTd DataLabel="Note">
                                @if (context.IsLowConfidence)
                                {
                                    <MudTooltip Text="Low confidence: relay-on minutes are low in this window, so efficiency can swing more with small temperature changes.">
                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning">
                                            Low confidence
                                        </MudChip>
                                    </MudTooltip>
                                }
                                else
                                {
                                    @context.Note
                                }
                            </MudTd>
                            <MudTd DataLabel="Review">
                                @if (EfficiencyRowNeedsReview(context))
                                {
                                    <MudStack Row="true" Spacing="1" AlignItems="AlignItems.Center">
                                        <MudLink Href="/schedules" Typo="Typo.caption">Schedules</MudLink>
                                        <MudText Typo="Typo.caption" Class="mud-text-secondary">·</MudText>
                                        <MudLink Href="@GetRoomDetailsHref(context.Room)" Typo="Typo.caption">Room targets</MudLink>
                                    </MudStack>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">—</MudText>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" Class="charts-grid-cell">
            <MudPaper Class="pa-3 chart-card charts-grid-paper">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <i class="fa-solid fa-arrows-rotate"></i> Boiler cycle health
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Short-cycle estimate from relay on/off transitions in poll data. Very short runs can indicate inefficiency.
                </MudText>
                @if (_boilerCycleSummary is null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No boiler cycle data in this window.</MudAlert>
                }
                else
                {
                    <MudGrid Spacing="1">
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Cycles</MudText>
                            <MudText Typo="Typo.body1">@_boilerCycleSummary.TotalCycles</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Short cycles</MudText>
                            <MudText Typo="Typo.body1">@_boilerCycleSummary.ShortCycles</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Short ratio</MudText>
                            <MudText Typo="Typo.body1">@_boilerCycleSummary.ShortCycleRatioText</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Threshold</MudText>
                            <MudText Typo="Typo.body1">@($"{_boilerCycleSummary.ShortCycleThresholdMin} min")</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Shortest</MudText>
                            <MudText Typo="Typo.body1">@Fmt(_boilerCycleSummary.ShortestCycleMinutes)</MudText>
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudText Typo="Typo.caption" Class="mud-text-secondary">Median</MudText>
                            <MudText Typo="Typo.body1">@Fmt(_boilerCycleSummary.MedianCycleMinutes)</MudText>
                        </MudItem>
                    </MudGrid>
                    @if (_boilerCycleSummary.ShortCycleRatio >= 0.35)
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            High short-cycling ratio in this window.
                        </MudAlert>
                    }
                }
            </MudPaper>
        </MudItem>
    </MudGrid>
    </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="Room trends" Icon="@Icons.Material.Filled.ShowChart">
    <MudStack Spacing="2">
    <MudPaper Class="pa-3 card-soft charts-toolbar">
        <MudText Typo="Typo.h6" Class="mb-2">
            <i class="fa-solid fa-wave-square"></i> Room trend chart
        </MudText>
        <MudGrid Spacing="2">
            <MudItem xs="12" md="5">
                <MudTooltip Text="Choose a room to update the trend chart.">
                    <MudSelect T="string"
                               Label="Room"
                               Value="_selectedRoom"
                               ValueChanged="OnRoomChanged"
                               FullWidth="true"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Margin="Margin.Dense"
                               Class="touch-control">
                        @foreach (var room in _rooms)
                        {
                            <MudSelectItem Value="@room">@room</MudSelectItem>
                        }
                    </MudSelect>
                </MudTooltip>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudSelect T="int"
                           Label="Window"
                           Value="_hours"
                           ValueChanged="OnHoursChanged"
                           Variant="Variant.Outlined"
                           Dense="true"
                           Margin="Margin.Dense"
                           Class="touch-control">
                    <MudSelectItem Value="12">12 hours</MudSelectItem>
                    <MudSelectItem Value="24">24 hours</MudSelectItem>
                    <MudSelectItem Value="48">48 hours</MudSelectItem>
                    <MudSelectItem Value="168">7 days</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="6" md="2" Class="d-flex align-center charts-outdoor-wrap">
                <MudCheckBox T="bool"
                             Label="Include outdoor"
                             Value="_includeOutdoor"
                             ValueChanged="OnOutdoorChanged"
                             Class="touch-control" />
            </MudItem>
            <MudItem xs="12" md="2" Class="d-flex align-stretch">
                <MudTooltip Text="Reload all chart data from the database for the selected window.">
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Refresh"
                               FullWidth="true"
                               Class="touch-target charts-refresh-btn"
                               OnClick="LoadChartAsync">
                        Refresh
                    </MudButton>
                </MudTooltip>
            </MudItem>
        </MudGrid>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-2">
            <MudText Typo="Typo.caption" Class="mud-text-secondary">@LastUpdatedText</MudText>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@DailySummaryCsvHref">
                Export daily CSV
            </MudButton>
            <MudButton Variant="Variant.Outlined"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.Download"
                       Href="@RoomTrendsCsvHref">
                Export trends CSV
            </MudButton>
        </MudStack>
    </MudPaper>

    @* Room trend + compliance: half width each from md up (toolbar stays full width above). *@
    <MudGrid Spacing="2" Class="charts-two-col-row charts-line-pair-row">
        <MudItem xs="12" md="6" Class="charts-grid-cell">
            <MudPaper id="selected-room-trend" Class="pa-3 chart-card charts-grid-paper">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <i class="fa-solid fa-chart-area"></i> Selected room trend
                </MudText>
                @if (!string.IsNullOrWhiteSpace(_error))
                {
                    <MudAlert Severity="Severity.Error" Dense="true">@_error</MudAlert>
                }
                else if (_roomTrend is null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No chart data yet.</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                        Click a legend item to hide a line. Shaded spans are when heating was off.
                    </MudText>
                    <RoomHistoryChart Data="_roomTrend"
                                      ShowOutdoor="_includeOutdoor"
                                      GroupId="charts-room-trend"
                                      ResetKey="@($"{_selectedRoom}|{_hours}|{_includeOutdoor}")"
                                      TempHeight="260"
                                      ValveHeight="150" />
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" Class="charts-grid-cell">
            <MudPaper Class="pa-3 chart-card charts-grid-paper">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <i class="fa-solid fa-calendar-check"></i> Comfort Compliance Timeline (7 days)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Share of each day's readings, across all rooms, that were inside the room's recommended range.
                </MudText>
                @if (_comfortCompliancePoints.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No compliance data yet.</MudAlert>
                }
                else
                {
                    <CategoryChart Id="comfort-compliance"
                                   Points="_comfortCompliancePoints"
                                   Name="In range"
                                   Bar="false"
                                   Unit="%"
                                   Decimals="0"
                                   YMin="0"
                                   YMax="100"
                                   Height="300" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    @* Bar charts side-by-side from md breakpoint up (similar vertical scale, saves vertical scroll). *@
    <MudGrid Spacing="2" Class="charts-two-col-row">
        <MudItem xs="12" md="6" Class="charts-grid-cell">
            <MudPaper Class="pa-3 chart-card charts-grid-paper">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <i class="fa-solid fa-sliders"></i> Current Deviation Chart (vs target midpoint)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Current temperature minus the middle of each room's recommended range: orange is warmer, blue is colder.
                </MudText>
                @if (_currentDeviationPoints.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No deviation data yet.</MudAlert>
                }
                else
                {
                    <CategoryChart Id="current-deviation"
                                   Points="_currentDeviationPoints"
                                   Name="Deviation"
                                   Horizontal="true"
                                   Unit=" °C"
                                   Decimals="1"
                                   AxisDecimals="1"
                                   Color="@ApexTheme.Orange"
                                   NegativeColor="@ApexTheme.Blue" />
                }
            </MudPaper>
        </MudItem>
        <MudItem xs="12" md="6" Class="charts-grid-cell">
            <MudPaper Class="pa-3 chart-card charts-grid-paper">
                <MudText Typo="Typo.h6" Class="mb-2">
                    <i class="fa-solid fa-clock"></i> Heating Runtime Distribution (local hour of day)
                </MudText>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Boiler relay-on minutes by hour of day over the selected window.
                </MudText>
                @if (_runtimeDistributionPoints.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No heating runtime data yet.</MudAlert>
                }
                else
                {
                    <CategoryChart Id="runtime-distribution"
                                   Points="_runtimeDistributionPoints"
                                   Name="Relay on"
                                   Unit=" min"
                                   Decimals="0"
                                   Height="300" />
                }
            </MudPaper>
        </MudItem>
    </MudGrid>

    <MudPaper Class="pa-3 chart-card">
        <MudText Typo="Typo.h6" Class="mb-2">
            <i class="fa-solid fa-code-compare"></i> Room comparison
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
            Overlay two rooms on a shared time axis to compare temperature trends directly.
        </MudText>
        <MudGrid Spacing="2" Class="mb-2">
            <MudItem xs="12" sm="5">
                <MudSelect T="string" Label="Room A" Value="_compareRoomA" ValueChanged="OnCompareRoomAChanged"
                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="touch-control">
                    @foreach (var r in _rooms)
                    {
                        <MudSelectItem Value="@r">@r</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="5">
                <MudSelect T="string" Label="Room B" Value="_compareRoomB" ValueChanged="OnCompareRoomBChanged"
                           Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" Class="touch-control">
                    @foreach (var r in _rooms)
                    {
                        <MudSelectItem Value="@r">@r</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
        @if (_compareRoomA == _compareRoomB)
        {
            <MudAlert Severity="Severity.Info" Dense="true">Select two different rooms to compare.</MudAlert>
        }
        else if (CompareLines.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">No data for the selected rooms in this window.</MudAlert>
        }
        else
        {
            var cmpRange = RoomHistoryChartBuilder.TemperatureRange(CompareLines.Select(static l => l.Points).ToArray());
            <TimeLinesChart Id="compare-rooms"
                            Group="compare-rooms"
                            Lines="CompareLines"
                            Unit="°C"
                            Decimals="1"
                            YMin="cmpRange.Min"
                            YMax="cmpRange.Max"
                            YTickAmount="@((int)((cmpRange.Max - cmpRange.Min) / cmpRange.Step))"
                            Height="280"
                            ZoomState="_compareZoom"
                            ResetKey="@($"{_compareRoomA}|{_compareRoomB}|{_hours}")" />
        }
    </MudPaper>

    </MudStack>
    </MudTabPanel>

    <MudTabPanel Text="Daily summary" Icon="@Icons.Material.Filled.TableChart">
    <MudPaper Class="pa-4 table-card">
        <MudText Typo="Typo.h6" Class="mb-2">
            <i class="fa-solid fa-table"></i> Daily summary (energy proxies)
        </MudText>
        <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">
            Sort and filter columns. Values are estimates from hub poll activity and outdoor samples.
        </MudText>
        <MudDataGrid T="DailySummaryRow"
                     Items="@_dailyRows"
                     Dense="true"
                     Hover="true"
                     Filterable="true"
                     FilterMode="DataGridFilterMode.ColumnFilterRow"
                     SortMode="SortMode.Multiple"
                     Breakpoint="Breakpoint.Sm"
                     RowsPerPage="20"
                     Class="daily-summary-grid">
            <Columns>
                <PropertyColumn Property="x => x.Date" Title="Date (Local)" Sortable="true" />
                <TemplateColumn Title="HDD" Sortable="true" SortBy="@(x => x.Hdd)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="text-right">@FmtOpt(context.Item.Hdd)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Avg outdoor °C" Sortable="true" SortBy="@(x => x.AvgOutdoorC)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="text-right">@FmtOpt(context.Item.AvgOutdoorC)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Heat demand est. min" Sortable="true" SortBy="@(x => x.HeatingActiveEstimateMin)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="text-right">@Fmt(context.Item.HeatingActiveEstimateMin)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <TemplateColumn Title="Boiler relay est. min" Sortable="true" SortBy="@(x => x.HeatingRelayEstimateMin)">
                    <CellTemplate>
                        <MudText Typo="Typo.body2" Class="text-right">@Fmt(context.Item.HeatingRelayEstimateMin)</MudText>
                    </CellTemplate>
                </TemplateColumn>
                <PropertyColumn Property="x => x.OutdoorSamples" Title="Outdoor samples" Sortable="true" />
            </Columns>
        </MudDataGrid>
    </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Gas vs heating" Icon="@Icons.Material.Filled.LocalFireDepartment">
        <MudPaper Class="pa-4 table-card">
            <MudText Typo="Typo.h6" Class="mb-2">
                <i class="fa-solid fa-fire-flame-curved"></i> Weekly estimated gas vs heating proxies
            </MudText>
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2 d-block">
                Gas cost uses a <strong>prepayment (credit) meter</strong>: <strong>credit used</strong> = older reading − newer reading; cost = used × <strong>1000</strong> × (Amount ÷ Vol Credit) from the <strong>latest receipt only</strong> — historical tariffs are not applied. Top-ups (reading goes up) are skipped for spend.
                Each interval is booked to the <strong>ISO week of the later reading</strong> (local time).
                HDD needs <strong>Open-Meteo</strong> outdoor data (lat/lon in settings); otherwise HDD stays blank.
            </MudText>
            <MudGrid Spacing="2" Class="mb-3">
                <MudItem xs="12" sm="6" md="4">
                    <MudSelect T="int"
                               Label="Weeks to show"
                               Value="_gasWeeksToShow"
                               ValueChanged="OnGasWeeksChanged"
                               Variant="Variant.Outlined"
                               Dense="true"
                               Margin="Margin.Dense"
                               Class="touch-control">
                        @for (var w = 4; w <= 16; w++)
                        {
                            var weeksOption = w;
                            <MudSelectItem Value="@weeksOption">@weeksOption weeks</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            </MudGrid>
            @if (!_gasWeekHasReceipt)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                    Add a gas receipt with Vol Credit and Amount on the Gas meter page to estimate weekly spend.
                </MudAlert>
            }
            @if (_gasWeekReadingPairs < 1)
            {
                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-2">
                    At least two meter readings are needed to attribute gas use to weeks.
                </MudAlert>
            }
            @if (_gasWeekRows.Count == 0)
            {
                <MudAlert Severity="Severity.Info" Dense="true">No weekly rows to show.</MudAlert>
            }
            else
            {
                <MudTable T="GasWeekInsightRow" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm" Items="_gasWeekRows">
                    <HeaderContent>
                        <MudTh>Week</MudTh>
                        <MudTh Class="text-right">Est. gas (GBP)</MudTh>
                        <MudTh Class="text-right">HDD Σ</MudTh>
                        <MudTh Class="text-right">Heat est. (min)</MudTh>
                        <MudTh>Note</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd DataLabel="Week">@context.WeekLabel</MudTd>
                        <MudTd DataLabel="Est. gas" Class="text-right">@FmtGasGbp(context.EstimatedGasGbp)</MudTd>
                        <MudTd DataLabel="HDD" Class="text-right">@FmtOpt(context.HddSum)</MudTd>
                        <MudTd DataLabel="Heat min" Class="text-right">@Fmt(context.HeatMinutesSum)</MudTd>
                        <MudTd DataLabel="Note">
                            <MudText Typo="Typo.body2">@context.Narrative</MudText>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudPaper>
    </MudTabPanel>

    <MudTabPanel Text="Overrides" Icon="@Icons.Material.Filled.TrendingDown">
        <OverrideHistoryCard />
    </MudTabPanel>
    </MudTabs>
</MudStack>

@code {
    private List<string> _rooms = [];
    private string _selectedRoom = string.Empty;
    private int _hours = 24;
    private bool _includeOutdoor = true;
    private string? _error;
    private DateTimeOffset? _lastRefreshAt;
    private PeriodicTimer? _chartsRefreshTimer;
    private CancellationTokenSource? _chartsRefreshCts;
    private int _qualityTotal24h;
    private List<DataQualityReasonCount> _qualityReasons24h = [];

    private RoomHistoryChartBuilder.Result? _roomTrend;
    private List<AlignedSeries> _heatCallingTemp = [];
    private List<AlignedSeries> _heatCallingValve = [];
    private bool _heatCallingHasAnyPlottedSeries;
    private readonly HashSet<string> _heatCallingHiddenRooms = new(StringComparer.OrdinalIgnoreCase);
    private List<string> _heatCallingRoomPickerNames = [];
    private readonly ChartZoomState _heatCallingZoom = new();
    private readonly ChartZoomState _compareZoom = new();

    private bool HeatCallingAnyRoomVisible =>
        _heatCallingRoomPickerNames.Exists(n => !_heatCallingHiddenRooms.Contains(n));

    private string HeatCallingResetKey => string.Join(",", _heatCallingHiddenRooms.Order(StringComparer.OrdinalIgnoreCase));

    /// <summary>Colour follows the room (its position in the picker), so hiding a room never repaints the others.</summary>
    private IReadOnlyList<TimeLine> HeatCallingTempLines => HeatCallingLines(_heatCallingTemp, ApexCharts.Curve.Smooth, 2);

    private IReadOnlyList<TimeLine> HeatCallingValveLines => HeatCallingLines(_heatCallingValve, ApexCharts.Curve.Stepline, 1.5);

    private List<TimeLine> HeatCallingLines(List<AlignedSeries> series, ApexCharts.Curve curve, double width) =>
        series
            .Where(s => !_heatCallingHiddenRooms.Contains(s.Name))
            .Select(s =>
            {
                var i = _heatCallingRoomPickerNames.IndexOf(s.Name);
                return new TimeLine(s.Name, s.Points, ApexTheme.ColorAt(i), curve, width, ApexTheme.DashAt(i));
            })
            .ToList();

    private readonly List<RoomHeatTile> _roomTiles = [];
    private readonly List<DailySummaryRow> _dailyRows = [];
    private readonly List<GasWeekInsightRow> _gasWeekRows = [];
    private readonly List<RoomEfficiencyRow> _roomEfficiencyRows = [];
    private BoilerCycleSummary? _boilerCycleSummary;
    private IReadOnlyList<SystemSeriesRow> _systemRowsWindow = [];
    private int _gasWeeksToShow = 8;
    private bool _gasWeekHasReceipt;
    private int _gasWeekReadingPairs;
    private List<CategoryPoint> _comfortCompliancePoints = [];
    private List<CategoryPoint> _currentDeviationPoints = [];
    private List<CategoryPoint> _runtimeDistributionPoints = [];
    private Dictionary<string, bool> _roomIsActiveMap = new(StringComparer.OrdinalIgnoreCase);
    private Dictionary<string, HubLiveRoom>? _liveHubByRoom;
    private const double ShortCycleThresholdMinutes = 5.0;
    private const string ChartRoomStorageKey = "wiser-chart-room";
    private const string ChartHoursStorageKey = "wiser-chart-hours";
    private const string ChartOutdoorStorageKey = "wiser-chart-include-outdoor";
    private string LastUpdatedText => _lastRefreshAt is null
        ? "Last updated: never"
        : $"Last updated: {_lastRefreshAt.Value:HH:mm:ss} ({(int)Math.Max(0, (DateTimeOffset.Now - _lastRefreshAt.Value).TotalSeconds)}s ago)";
    private string DailySummaryCsvHref => "/api/export/daily-summary.csv?days=14";
    private string RoomTrendsCsvHref => $"/api/export/room-trends.csv?hours={_hours}";
    private TimeZoneInfo DisplayZone => TimeZoneResolver.Resolve(Options.TimeZoneId);

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        // JS interop and initial chart load must run here — JS unavailable during pre-render.
        await TryLoadPersistedChartFiltersAsync();
        ValidateChartFilters();
        await LoadChartAsync();
        _chartsRefreshCts = new CancellationTokenSource();
        _chartsRefreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(60));
        _ = PumpChartsRefreshAsync();
        StateHasChanged();
    }

    private async Task PumpChartsRefreshAsync()
    {
        try
        {
            while (_chartsRefreshTimer is not null &&
                   await _chartsRefreshTimer.WaitForNextTickAsync(_chartsRefreshCts?.Token ?? default))
            {
                await InvokeAsync(async () =>
                {
                    await LoadChartAsync();
                    StateHasChanged();
                });
            }
        }
        catch (OperationCanceledException)
        {
        }
    }

    public ValueTask DisposeAsync()
    {
        _chartsRefreshCts?.Cancel();
        _chartsRefreshCts?.Dispose();
        _chartsRefreshTimer?.Dispose();
        return ValueTask.CompletedTask;
    }

    protected override Task OnInitializedAsync()
    {
        LoadRooms();
        ValidateChartFilters();
        LoadDailyRows();
        return Task.CompletedTask;
    }

    private void LoadRooms()
    {
        _rooms = Store.ListRooms().OrderBy(x => x, StringComparer.OrdinalIgnoreCase).ToList();
        if (_rooms.Count > 0 &&
            (string.IsNullOrWhiteSpace(_selectedRoom) || !_rooms.Contains(_selectedRoom, StringComparer.OrdinalIgnoreCase)))
        {
            _selectedRoom = _rooms[0];
        }
        if (_rooms.Count >= 2)
        {
            if (string.IsNullOrWhiteSpace(_compareRoomA) || !_rooms.Contains(_compareRoomA, StringComparer.OrdinalIgnoreCase))
                _compareRoomA = _rooms[0];
            if (string.IsNullOrWhiteSpace(_compareRoomB) || !_rooms.Contains(_compareRoomB, StringComparer.OrdinalIgnoreCase))
                _compareRoomB = _rooms[1];
        }
    }

    private Task OnRoomChanged(string? room)
    {
        _selectedRoom = room ?? string.Empty;
        _ = PersistChartFiltersAsync();
        return LoadChartAsync();
    }

    private Task OnHoursChanged(int hours)
    {
        _hours = hours;
        _ = PersistChartFiltersAsync();
        return LoadChartAsync();
    }

    private Task OnOutdoorChanged(bool include)
    {
        _includeOutdoor = include;
        _ = PersistChartFiltersAsync();
        return LoadChartAsync();
    }

    private void ValidateChartFilters()
    {
        if (_hours is not (12 or 24 or 48 or 168))
            _hours = 24;

        if (_rooms.Count == 0)
        {
            _selectedRoom = string.Empty;
            return;
        }

        if (string.IsNullOrWhiteSpace(_selectedRoom)
            || !_rooms.Contains(_selectedRoom, StringComparer.OrdinalIgnoreCase))
        {
            _selectedRoom = _rooms[0];
        }
    }

    private async Task TryLoadPersistedChartFiltersAsync()
    {
        try
        {
            var room = await Js.InvokeAsync<string?>("localStorage.getItem", ChartRoomStorageKey);
            var hoursRaw = await Js.InvokeAsync<string?>("localStorage.getItem", ChartHoursStorageKey);
            var outdoorRaw = await Js.InvokeAsync<string?>("localStorage.getItem", ChartOutdoorStorageKey);

            if (!string.IsNullOrWhiteSpace(room))
                _selectedRoom = room.Trim();
            if (int.TryParse(hoursRaw, out var h))
                _hours = h;
            if (outdoorRaw == "0")
                _includeOutdoor = false;
            else if (outdoorRaw == "1")
                _includeOutdoor = true;
        }
        catch
        {
            // Ignore storage errors (e.g. JS unavailable on early render).
        }
    }

    private async Task PersistChartFiltersAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", ChartRoomStorageKey, _selectedRoom ?? string.Empty);
            await Js.InvokeVoidAsync("localStorage.setItem", ChartHoursStorageKey, _hours.ToString(CultureInfo.InvariantCulture));
            await Js.InvokeVoidAsync("localStorage.setItem", ChartOutdoorStorageKey, _includeOutdoor ? "1" : "0");
        }
        catch
        {
            // Ignore persistence failures.
        }
    }

    private async Task LoadChartAsync()
    {
        _roomRanges = await Task.Run(() => Store.GetRoomRanges()).ConfigureAwait(false);
        _error = null;
        _roomTrend = null;
        _heatCallingTemp = [];
        _heatCallingValve = [];
        _heatCallingHasAnyPlottedSeries = false;
        _heatCallingRoomPickerNames = [];
        _roomTiles.Clear();
        _comfortCompliancePoints = [];
        _currentDeviationPoints = [];
        _runtimeDistributionPoints = [];
        _roomEfficiencyRows.Clear();
        _boilerCycleSummary = null;
        _systemRowsWindow = [];
        _roomIsActiveMap = new(StringComparer.OrdinalIgnoreCase);

        try
        {
            // Use the cached hub snapshot for live temperature overlay; no outbound HTTP on every chart load.
            _liveHubByRoom = RoomsCache.TryGetSnapshot(out var cached, out _)
                ? LiveHubRoomTemps.ToAvailableTempByRoomName(cached)
                : null;

            LoadRooms();
            await Task.Run(LoadGasWeekInsights).ConfigureAwait(false);

            var since24h = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - (HeatCallingTrendHours * 3600L);
            await Task.Run(() => BuildHeatCallingRoomsTimeseries(since24h)).ConfigureAwait(false);
            LoadDataQualitySummary();

            var since = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - (_hours * 3600L);
            _systemRowsWindow = await Task.Run(() => Store.SeriesSystem(since)).ConfigureAwait(false);

            if (!string.IsNullOrWhiteSpace(_selectedRoom))
            {
                var trendRows = await Task.Run(() => Store.SeriesRoom(_selectedRoom, since)).ConfigureAwait(false);
                var outdoor = _includeOutdoor && Options.OpenMeteoLat is not null
                    ? await Task.Run(() => Store.SeriesOutdoor(since)).ConfigureAwait(false)
                    : null;
                _roomTrend = RoomHistoryChartBuilder.Build(trendRows, outdoor, DisplayZone);
            }

            BuildRoomHeatMap(since);
            BuildComfortComplianceTimeline(days: 7);
            BuildCurrentDeviationChart();
            BuildRoomEfficiencyScores(since);
            BuildHeatingRuntimeDistribution();
            BuildBoilerCycleHealth();
            BuildComparisonChart();
        }
        catch (Exception ex)
        {
            _error = $"Failed loading chart data: {ex.Message}";
        }
        _lastRefreshAt = DateTimeOffset.Now;
    }

    private Task OnGasWeeksChanged(int weeks)
    {
        _gasWeeksToShow = weeks;
        LoadGasWeekInsights();
        StateHasChanged();
        return Task.CompletedTask;
    }

    private void LoadGasWeekInsights()
    {
        var receipts = Store.ListGasMeterReceipts();
        var latestReceipt = receipts.FirstOrDefault();
        _gasWeekHasReceipt = latestReceipt is { VolCredit: > 0 };

        var readings = Store.ListGasMeterReadings();
        var asc = readings.OrderBy(static r => r.ReadTs).ToList();
        _gasWeekReadingPairs = asc.Count >= 2
            ? Enumerable.Range(1, asc.Count - 1).Count(i => asc[i - 1].ReadingValue - asc[i].ReadingValue > 0)
            : 0;

        var days = 7 * _gasWeeksToShow + 14;
        var daily = Store.GetDailySummaries(days, Math.Max(10, Options.IntervalSec), DisplayZone);

        _gasWeekRows.Clear();
        _gasWeekRows.AddRange(GasHeatingWeekInsights.Build(readings, latestReceipt, daily, DisplayZone, _gasWeeksToShow));
    }

    private static string FmtGasGbp(decimal gbp) =>
        gbp <= 0 ? "—" : $"£{gbp.ToString("0.00", CultureInfo.InvariantCulture)}";

    private void LoadDataQualitySummary()
    {
        var summary = Store.GetDataQualitySummary(24);
        _qualityTotal24h = summary.TotalIgnored;
        _qualityReasons24h = summary.ByReason.Take(4).ToList();
    }

    private const int HeatCallingTrendHours = 24;

    private static bool IsPlausibleHeatChartTemp(double tempC) => tempC is > -45 and < 75;

    /// <summary>
    /// Multi-room 24h view: per-room temperature (smoothed) and valve demand %, aligned on one time axis
    /// so the shared tooltip lists every room at the hovered time.
    /// </summary>
    private void BuildHeatCallingRoomsTimeseries(long sinceTsUtc)
    {
        var qualifying = Store.ListRoomsCallingHeatSince(sinceTsUtc);
        if (qualifying.Count == 0)
            return;

        var qualifyingSet = new HashSet<string>(qualifying, StringComparer.OrdinalIgnoreCase);
        _heatCallingHiddenRooms.IntersectWith(qualifyingSet);

        var orderedRooms = qualifying
            .Select(room => (Room: room, Rows: Store.SeriesRoom(room, sinceTsUtc)))
            .Where(x => x.Rows.Count > 0)
            .OrderBy(x => x.Room, StringComparer.OrdinalIgnoreCase)
            .ToList();

        if (orderedRooms.Count == 0)
            return;

        _heatCallingRoomPickerNames = [.. orderedRooms.Select(static x => x.Room)];

        var temps = orderedRooms
            .Select(x => (x.Room, (IReadOnlyList<(long Ts, double Value)>)SmoothedTemps(x.Rows)))
            .ToList();
        var valves = orderedRooms
            .Select(x => (x.Room, (IReadOnlyList<(long Ts, double Value)>)x.Rows
                .Where(static r => r.PercentageDemand.HasValue)
                .Select(static r => (r.Ts, (double)r.PercentageDemand!.Value))
                .ToList()))
            .ToList();

        _heatCallingTemp = MultiSeriesAligner.Align(temps, DisplayZone, MultiSeriesAligner.Aggregate.Average, decimals: 2)
            .Where(static s => s.Points.Any(static p => p.Y is not null))
            .ToList();
        _heatCallingValve = MultiSeriesAligner.Align(valves, DisplayZone, MultiSeriesAligner.Aggregate.Max, decimals: 0)
            .Where(static s => s.Points.Any(static p => p.Y is not null))
            .ToList();
        _heatCallingHasAnyPlottedSeries = _heatCallingTemp.Count > 0 || _heatCallingValve.Count > 0;
    }

    /// <summary>Plausible readings, one per timestamp, lightly smoothed (0.1 °C sensor steps).</summary>
    private static List<(long Ts, double Value)> SmoothedTemps(IReadOnlyList<RoomSeriesRow> rows)
    {
        var pts = rows
            .Where(static r => IsPlausibleHeatChartTemp(r.TempC))
            .GroupBy(static r => r.Ts)
            .Select(static g => g.Last())
            .OrderBy(static r => r.Ts)
            .ToList();
        var values = pts.Select(static r => r.TempC).ToArray();
        RoomHistoryChartBuilder.SmoothInPlace(values);
        return pts.Select((r, i) => (r.Ts, values[i])).ToList();
    }

    private void ToggleHeatCallingRoomVisibility(string room)
    {
        if (_heatCallingHiddenRooms.Contains(room))
            _heatCallingHiddenRooms.Remove(room);
        else
            _heatCallingHiddenRooms.Add(room);

        ApplyHeatCallingSeriesVisibility();
    }

    private void ClearHeatCallingHiddenRooms()
    {
        _heatCallingHiddenRooms.Clear();
        ApplyHeatCallingSeriesVisibility();
    }

    private void ApplyHeatCallingSeriesVisibility() => StateHasChanged();

    private double ResolveDisplayTempC(string room, double storedTempC)
    {
        if (_liveHubByRoom is not null
            && _liveHubByRoom.TryGetValue(room, out var live)
            && !LiveHubRoomTemps.IsUnavailableTemp(live.TempC))
            return live.TempC;
        return storedTempC;
    }

    private void BuildRoomHeatMap(long sinceTs)
    {
        if (_rooms.Count == 0)
            return;

        var activityMap = Store.GetRoomActivityMap();
        _roomIsActiveMap = activityMap;
        var (ignoreStart, ignoreEnd) = Store.GetTrendIgnoreWindow();
        _roomTiles.Clear();
        var tiles = new List<RoomHeatTile>(_rooms.Count);

        foreach (var room in _rooms)
        {
            var isActive = !activityMap.TryGetValue(room, out var activeFlag) || activeFlag;
            var rows = Store.SeriesRoom(room, sinceTs);
            if (rows.Count == 0)
            {
                var (missingMin, missingMax) = GetRecommendedTempRange(room, isActive);
                tiles.Add(new RoomHeatTile(
                    room,
                    null,
                    "—",
                    "#334155",
                    $"Recommended {missingMin:0.#} - {missingMax:0.#}C",
                    $"No data in selected period{(isActive ? string.Empty : ", inactive profile")}",
                    "Trend unavailable",
                    null,
                    -1,
                    0,
                    0,
                    "Current state unavailable",
                    "#94a3b8"));
                continue;
            }

            var storedCurrent = rows[^1].TempC;
            var displayTemp = ResolveDisplayTempC(room, storedCurrent);
            var trendRows = rows
                .Where(x => !IsWithinIgnoreWindow(x.Ts, ignoreStart, ignoreEnd, DisplayZone))
                .ToList();
            if (trendRows.Count == 0)
            {
                var (missingMin, missingMax) = GetRecommendedTempRange(room, isActive);
                var bandColor = ComfortColors.GetGradientColor(displayTemp, missingMin, missingMax);
                var (cst, csc) = ComfortColors.GetCurrentState(displayTemp, missingMin, missingMax);
                tiles.Add(new RoomHeatTile(
                    room,
                    displayTemp,
                    $"{displayTemp:0.0}C",
                    bandColor,
                    $"Recommended {missingMin:0.#} - {missingMax:0.#}C",
                    $"No trend data outside ignored window{(isActive ? string.Empty : ", inactive profile")}",
                    $"Ignored {ignoreStart:hh\\:mm}-{ignoreEnd:hh\\:mm}",
                    null,
                    -1,
                    0,
                    0,
                    cst,
                    csc));
                continue;
            }

            var average = trendRows.Average(static x => x.TempC);
            var trendDelta = trendRows[^1].TempC - trendRows[0].TempC;

            var (rangeMin, rangeMax) = GetRecommendedTempRange(room, isActive);
            var status = average < rangeMin
                ? "Too cold"
                : average > rangeMax
                    ? "Too hot"
                    : "In range";
            var statusRank = status switch
            {
                "Too hot" => 2,
                "In range" => 1,
                _ => 0,
            };
            var severity = status switch
            {
                "Too hot" => average - rangeMax,
                "Too cold" => rangeMin - average,
                _ => Math.Abs(average - ((rangeMin + rangeMax) / 2.0)),
            };
            var sortKeyWithinBand = status == "Too cold" ? severity : -severity;

            var color = ComfortColors.GetGradientColor(displayTemp, rangeMin, rangeMax);
            var (currentStateText, currentStateColor) = ComfortColors.GetCurrentState(displayTemp, rangeMin, rangeMax);
            tiles.Add(new RoomHeatTile(
                room,
                displayTemp,
                $"{displayTemp:0.0}C",
                color,
                $"Recommended {rangeMin:0.#} - {rangeMax:0.#}C",
                $"{status} (avg {average:0.0}C over {_hours}h){(isActive ? string.Empty : ", inactive profile")}",
                $"Trend {FormatTrend(trendDelta)}",
                trendDelta,
                statusRank,
                severity,
                sortKeyWithinBand,
                currentStateText,
                currentStateColor));
        }

        _roomTiles.AddRange(tiles
            .OrderByDescending(static x => x.StatusRank)
            .ThenBy(static x => x.SortKeyWithinBand)
            .ThenByDescending(static x => x.TrendDeltaC.HasValue)
            .ThenByDescending(static x => x.TrendDeltaC)
            .ThenBy(static x => RoomDisplayPriority.KindOrder(x.Room))
            .ThenBy(static x => x.Room, StringComparer.OrdinalIgnoreCase));
    }

    private void BuildComfortComplianceTimeline(int days)
    {
        days = Math.Clamp(days, 1, 31);
        if (_rooms.Count == 0)
            return;

        var activityMap = Store.GetRoomActivityMap();
        var (ignoreStart, ignoreEnd) = Store.GetTrendIgnoreWindow();
        var zone = DisplayZone;
        var todayLocal = TimeZoneInfo.ConvertTime(DateTimeOffset.UtcNow, zone).Date;
        var labels = new string[days];
        var values = new double[days];
        var hasAnySample = false;

        // Single bulk query for the entire window instead of per-room-per-day.
        var windowStart = new DateTimeOffset(todayLocal.AddDays(-(days - 1)), zone.GetUtcOffset(todayLocal.AddDays(-(days - 1)))).ToUnixTimeSeconds();
        var windowEnd = new DateTimeOffset(todayLocal.AddDays(1), zone.GetUtcOffset(todayLocal.AddDays(1))).ToUnixTimeSeconds();
        var allRows = Store.SeriesAllRooms(windowStart, windowEnd);

        for (var i = 0; i < days; i++)
        {
            var day = todayLocal.AddDays(-(days - 1 - i));
            labels[i] = day.ToString("ddd d", CultureInfo.CurrentCulture);

            var start = new DateTimeOffset(day, zone.GetUtcOffset(day)).ToUnixTimeSeconds();
            var end = new DateTimeOffset(day.AddDays(1), zone.GetUtcOffset(day.AddDays(1))).ToUnixTimeSeconds();

            var inRangeCount = 0;
            var totalCount = 0;
            foreach (var room in _rooms)
            {
                var isActive = !activityMap.TryGetValue(room, out var activeFlag) || activeFlag;
                var (targetMin, targetMax) = GetRecommendedTempRange(room, isActive);
                if (!allRows.TryGetValue(room, out var roomRows))
                    continue;
                foreach (var row in roomRows)
                {
                    if (row.Ts < start || row.Ts >= end) continue;
                    if (IsWithinIgnoreWindow(row.Ts, ignoreStart, ignoreEnd, zone)) continue;
                    hasAnySample = true;
                    totalCount++;
                    if (row.TempC >= targetMin && row.TempC <= targetMax)
                        inRangeCount++;
                }
            }

            values[i] = totalCount == 0 ? double.NaN : inRangeCount * 100.0 / totalCount;
        }

        if (!hasAnySample)
            return;

        // Days without samples stay as gaps rather than being bridged.
        _comfortCompliancePoints = labels
            .Select((label, i) => new CategoryPoint(label, double.IsNaN(values[i]) ? null : Math.Round((decimal)values[i], 1)))
            .ToList();
    }

    private void BuildCurrentDeviationChart()
    {
        if (_roomTiles.Count == 0)
            return;

        _currentDeviationPoints = _roomTiles
            .Select(t =>
            {
                if (t.TempC is null)
                    return new CategoryPoint(t.Room, null);
                var isActive = !_roomIsActiveMap.TryGetValue(t.Room, out var activeFlag) || activeFlag;
                var (targetMin, targetMax) = GetRecommendedTempRange(t.Room, isActive);
                var targetMid = (targetMin + targetMax) / 2.0;
                return new CategoryPoint(t.Room, Math.Round((decimal)(t.TempC.Value - targetMid), 1));
            })
            .ToList();
    }

    private void BuildHeatingRuntimeDistribution()
    {
        var systemRows = _systemRowsWindow;
        if (systemRows.Count == 0)
            return;

        var minutesByHour = new double[24];
        var minutesPerSample = Math.Max(10, Options.IntervalSec) / 60.0;
        var zone = DisplayZone;

        foreach (var row in systemRows)
        {
            if (row.HeatingRelayOn == 0)
                continue;
            var hour = TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(row.Ts), zone).Hour;
            minutesByHour[hour] += minutesPerSample;
        }

        _runtimeDistributionPoints = Enumerable.Range(0, 24)
            .Select(h => new CategoryPoint(h.ToString("00", CultureInfo.InvariantCulture), Math.Round((decimal)minutesByHour[h], 0)))
            .ToList();
    }

    private void BuildRoomEfficiencyScores(long sinceTs)
    {
        _roomEfficiencyRows.Clear();
        var minutesPerSample = Math.Max(10, Options.IntervalSec) / 60.0;
        var relayMinutes = RelayMinutesWithin(_systemRowsWindow, sinceTs, long.MaxValue, minutesPerSample);
        var previousWindowStart = sinceTs - (7L * 24 * 3600);
        var previousSystemRows = Store.SeriesSystem(previousWindowStart);
        var previousRelayMinutes = RelayMinutesWithin(previousSystemRows, previousWindowStart, sinceTs, minutesPerSample);
        foreach (var room in _rooms)
        {
            var rows = Store.SeriesRoom(room, sinceTs);
            if (rows.Count < 2 && previousRelayMinutes <= 0)
                continue;
            var positiveGain = PositiveGainWithin(rows, sinceTs, long.MaxValue);

            var score = relayMinutes > 0 ? positiveGain / relayMinutes : double.NaN;
            var prevRows = Store.SeriesRoom(room, previousWindowStart);
            var prevPositiveGain = PositiveGainWithin(prevRows, previousWindowStart, sinceTs);
            var prevScore = previousRelayMinutes > 0 ? prevPositiveGain / previousRelayMinutes : double.NaN;
            var weeklyDelta = !double.IsNaN(score) && !double.IsNaN(prevScore) ? score - prevScore : (double?)null;
            var note = relayMinutes switch
            {
                <= 0 => "No relay-on samples in window",
                < 30 => "Low confidence (little relay runtime)",
                _ when positiveGain <= 0 => "No positive gain observed",
                _ => "OK",
            };
            _roomEfficiencyRows.Add(new RoomEfficiencyRow(room, score, weeklyDelta, positiveGain, relayMinutes, relayMinutes < 30, note));
        }

        _roomEfficiencyRows.Sort(static (a, b) => b.ScoreCPerRelayMinute.CompareTo(a.ScoreCPerRelayMinute));
    }

    private static double RelayMinutesWithin(IReadOnlyList<SystemSeriesRow> rows, long fromInclusiveTs, long untilExclusiveTs, double minutesPerSample)
    {
        if (rows.Count == 0)
            return 0;
        var onSamples = rows.Count(x => x.Ts >= fromInclusiveTs && x.Ts < untilExclusiveTs && x.HeatingRelayOn != 0);
        return onSamples * minutesPerSample;
    }

    private static double PositiveGainWithin(IReadOnlyList<RoomSeriesRow> rows, long fromInclusiveTs, long untilExclusiveTs)
    {
        if (rows.Count < 2)
            return 0;
        double gain = 0;
        for (var i = 1; i < rows.Count; i++)
        {
            if (rows[i].Ts < fromInclusiveTs || rows[i].Ts >= untilExclusiveTs)
                continue;
            var delta = rows[i].TempC - rows[i - 1].TempC;
            if (delta > 0)
                gain += delta;
        }

        return gain;
    }

    private static string FormatEfficiencyTrend(double? delta)
    {
        if (delta is null || double.IsNaN(delta.Value))
            return "—";
        if (Math.Abs(delta.Value) < 0.02)
            return $"steady ({delta.Value:+0.00;-0.00;0.00})";
        return delta.Value > 0
            ? $"up (+{delta.Value:0.00})"
            : $"down ({delta.Value:0.00})";
    }

    private void BuildBoilerCycleHealth() =>
        _boilerCycleSummary = BoilerCycleAnalyzer.Summarize(_systemRowsWindow, ShortCycleThresholdMinutes);

    private void LoadDailyRows()
    {
        _dailyRows.Clear();
        _dailyRows.AddRange(
            Store.GetDailySummaries(14, Math.Max(10, Options.IntervalSec), DisplayZone)
                .OrderByDescending(static x => x.Date, StringComparer.Ordinal));
    }

    private static string Fmt(double value) => double.IsNaN(value) ? "—" : value.ToString("0.0");
    private static string FmtOpt(double? value) => value is null || double.IsNaN(value.Value) ? "—" : value.Value.ToString("0.0");
    private Dictionary<string, (double Min, double Max)> _roomRanges = new(StringComparer.OrdinalIgnoreCase);

    private string _compareRoomA = string.Empty;
    private string _compareRoomB = string.Empty;
    private List<AlignedSeries> _compareSeries = [];

    private IReadOnlyList<TimeLine> CompareLines =>
        _compareSeries
            .Select((s, i) => new TimeLine(s.Name, s.Points, ApexTheme.ColorAt(i), ApexCharts.Curve.Smooth, 2))
            .ToList();

    private (double Min, double Max) GetRecommendedTempRange(string roomName, bool isActive) =>
        RoomDisplayHelpers.GetRecommendedTempRange(roomName, isActive, _roomRanges);

    private static string FormatTrend(double trendDelta) =>
        RoomDisplayHelpers.FormatTrend(trendDelta);

    private static bool IsWithinIgnoreWindow(long timestampUtc, TimeSpan ignoreStart, TimeSpan ignoreEnd, TimeZoneInfo zone) =>
        RoomDisplayHelpers.IsWithinIgnoreWindow(timestampUtc, ignoreStart, ignoreEnd, zone);

    private static string GetRoomDetailsHref(string roomName) =>
        RoomDisplayHelpers.GetRoomDetailsHref(roomName);

    private Task OnCompareRoomAChanged(string room)
    {
        _compareRoomA = room;
        BuildComparisonChart();
        return Task.CompletedTask;
    }

    private Task OnCompareRoomBChanged(string room)
    {
        _compareRoomB = room;
        BuildComparisonChart();
        return Task.CompletedTask;
    }

    private void BuildComparisonChart()
    {
        _compareSeries = [];
        if (string.IsNullOrWhiteSpace(_compareRoomA) || string.IsNullOrWhiteSpace(_compareRoomB)
            || string.Equals(_compareRoomA, _compareRoomB, StringComparison.OrdinalIgnoreCase))
            return;

        var since = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - (_hours * 3600L);
        var input = new[] { _compareRoomA, _compareRoomB }
            .Select(room => (room, (IReadOnlyList<(long Ts, double Value)>)SmoothedTemps(Store.SeriesRoom(room, since))))
            .ToList();
        _compareSeries = MultiSeriesAligner.Align(input, DisplayZone, MultiSeriesAligner.Aggregate.Average, decimals: 2)
            .Where(static s => s.Points.Any(static p => p.Y is not null))
            .ToList();
    }

    private static bool EfficiencyRowNeedsReview(RoomEfficiencyRow r)
    {
        if (r.RelayMinutes < 30)
            return false;
        if (!double.IsNaN(r.ScoreCPerRelayMinute) && r.ScoreCPerRelayMinute < 0.03)
            return true;
        return r.PositiveTempGainC <= 0;
    }

    private sealed record RoomHeatTile(
        string Room,
        double? TempC,
        string DisplayTemp,
        string Color,
        string RangeText,
        string StatusText,
        string TrendText,
        double? TrendDeltaC,
        int StatusRank,
        double Severity,
        double SortKeyWithinBand,
        string CurrentStateText,
        string CurrentStateColor);

    private sealed record RoomEfficiencyRow(
        string Room,
        double ScoreCPerRelayMinute,
        double? WeeklyDeltaCPerRelayMinute,
        double PositiveTempGainC,
        double RelayMinutes,
        bool IsLowConfidence,
        string Note);

}

