    /// <summary>
    /// Whether the chosen temperature raises (1) or lowers (-1) the selected rooms' targets; 0 when mixed or unknown.
    /// A timed override works either way, so the wording follows the direction.
    /// </summary>
    private int QuickApplyDirection
    {
        get
        {
            if (_quickAdjustMode)
                return Math.Sign(_quickAdjustDeltaC);
            var targets = _quickActionRooms
                .Where(r => _boostRoomNames.Contains(r.Name) && r.TargetC is not null)
                .Select(static r => r.TargetC!.Value)
                .ToList();
            if (targets.Count == 0)
                return 1;
            var temp = QuickBoostTempClamped;
            if (targets.All(t => temp > t + 0.05))
                return 1;
            if (targets.All(t => temp < t - 0.05))
                return -1;
            return 0;
        }
    }

    private string QuickApplyVerb => QuickApplyDirection switch
    {
        1 => "Boost",
        -1 => "Lower",
        _ => "Set",
    };

    private string QuickApplyIcon => QuickApplyDirection switch
    {
        -1 => Icons.Material.Filled.TrendingDown,
        1 => Icons.Material.Filled.Bolt,
        _ => Icons.Material.Filled.Thermostat,
    };

