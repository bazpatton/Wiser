    private static string ResolveModeKey(string? mode, double? setpointC)
    {
        if (string.Equals(mode, "Auto", StringComparison.OrdinalIgnoreCase))
            return "auto";
        if (setpointC is double sp && sp < 5.0)
            return "off";
        return "manual";
    }

    private sealed record QuickActionRoom(int Id, string Name, bool IsFavorite, string ModeKey, double? ManualTemperatureC);
    private sealed record AwayRoomSnapshot(int RoomId, string Mode, double? ManualTemperatureC);
    private sealed record ActiveBoost(int RoomId, string Name, DateTimeOffset EndUtc, double? TargetC, bool IsBoost);
}

