@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Wiser.Monitor.Services
@implements IAsyncDisposable

@inject MonitorState MonitorState
@inject MonitorOptions Options
@inject TemperatureStore Store
@inject OutdoorWeatherClient OutdoorWeather
@inject WiserHubFetch Hub
@inject RoomsLiveDataCache RoomsCache
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject IDialogService DialogService

<PageTitle>Wiser Monitor</PageTitle>

<MudStack Spacing="3" Class="home-page-stack">
    @if (MonitorState.LowBatteryDevices.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" ShowCloseIcon="false"
                  ContentAlignment="HorizontalAlignment.Left">
            <div class="d-flex flex-wrap align-center" style="gap: 12px;">
                <MudText Typo="Typo.body1" Class="flex-grow-1">
                    Low battery (&lt;20%): @string.Join(", ", MonitorState.LowBatteryDevices)
                </MudText>
                <MudButton Href="/devices" Variant="Variant.Filled" Color="Color.Warning"
                           Size="Size.Small" StartIcon="@Icons.Material.Filled.Battery1Bar"
                           Class="touch-target">
                    Devices
                </MudButton>
            </div>
        </MudAlert>
    }
    @if (_gasMeterReadingBannerText is not null)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true"
                  Class="home-gas-meter-banner"
                  ShowCloseIcon="false"
                  ContentAlignment="HorizontalAlignment.Left">
            <div class="d-flex flex-wrap align-center" style="gap: 12px;">
                <MudText Typo="Typo.body1" Class="flex-grow-1">@_gasMeterReadingBannerText</MudText>
                <MudButton Href="/gas-meter"
                           Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.LocalGasStation"
                           Class="touch-target">
                    Gas meter
                </MudButton>
            </div>
        </MudAlert>
    }

    @{
        var timedAway = Store.TryGetActiveTimedAwaySession();
        var timedAwayOverdue = timedAway is not null
            && DateTimeOffset.UtcNow.ToUnixTimeSeconds() >= timedAway.EndsAtUnix;
    }
    @if (_hubSystemAway && timedAway is null)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true"
                  Class="home-hub-away-banner"
                  ShowCloseIcon="false">
            <MudText Typo="Typo.body2">
                <strong>Hub away mode</strong> is active (set outside this monitor schedule).
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@(_quickActionsBusy || !HubConfiguredForApi)"
                           OnClick="@ToggleAwayModeAsync">
                    Return Home
                </MudButton>
            </MudText>
        </MudAlert>
    }
    @if (timedAway is not null)
    {
        <MudAlert Severity="@(timedAwayOverdue ? Severity.Warning : Severity.Info)"
                  Dense="true"
                  Class="home-timed-away-banner"
                  ShowCloseIcon="false">
            <MudText Typo="Typo.body2">
                <span><strong>@(timedAwayOverdue ? "Timed away ended" : "Timed away")</strong> — @FormatTimedAwayBannerSummary(timedAway)</span>
                (@timedAway.Source, limit @timedAway.AwayLimitC.ToString("F1", CultureInfo.InvariantCulture) °C).
                <MudLink Href="/settings">Settings</MudLink>
                ·
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(60))">
                    +1h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(180))">
                    +3h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(360))">
                    +6h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(540))">
                    +9h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@(_timedAwayActionBusy || !HubConfiguredForApi)"
                           OnClick="@CancelMonitorTimedAwayAsync">
                    Cancel
                </MudButton>
            </MudText>
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_homeTrendBuildError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="home-trend-error-banner">
            Room trend tiles failed to build: @_homeTrendBuildError
        </MudAlert>
    }

    @if (_homeBoilerSummary is { ShortCycleRatio: >= 0.35 } boil)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true"
                  Class="home-boiler-cycle-banner"
                  ShowCloseIcon="false">
            <MudText Typo="Typo.body2">
                Boiler short-cycle ratio is high over the last @HomeTrendHours h (@boil.ShortCycleRatioText, threshold @boil.ShortCycleThresholdMin.ToString("F0", CultureInfo.InvariantCulture) min).
                <MudLink Href="/charts">Open Charts</MudLink> for cycle detail.
            </MudText>
        </MudAlert>
    }

    @if (HeatingNowRooms is { Count: > 0 } heatingRooms && PrimaryEaseOff is { } primaryEaseOff)
    {
        var heatingBusy = _quickActionsBusy || _heatingNowBusyRoomId is not null;
        <MudPaper Class="pa-3 home-heating-now">
            <div class="home-heating-now-head">
                <MudText Typo="Typo.subtitle1" Class="home-heating-now-title">
                    <MudIcon Icon="@Icons.Material.Filled.LocalFireDepartment" Color="Color.Warning" Size="Size.Small" />
                    Heating now (@heatingRooms.Count)
                </MudText>
                @if (heatingRooms.Count > 1)
                {
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@EaseOffIcon(primaryEaseOff)"
                               Disabled="@heatingBusy"
                               OnClick="@(() => EaseOffRoomsAsync(heatingRooms, primaryEaseOff))">
                        All @EaseOffShortLabel(null, primaryEaseOff)
                    </MudButton>
                }
            </div>
            @foreach (var room in heatingRooms)
            {
                var active = _activeBoosts.FirstOrDefault(b => b.RoomId == room.Id && b.EndUtc > DateTimeOffset.UtcNow);
                <div class="home-heating-now-row">
                    <div class="home-heating-now-text">
                        <MudText Typo="Typo.body2"><strong>@room.Name</strong></MudText>
                        <MudText Typo="Typo.caption" Class="mud-text-secondary">
                            @(QuickRoomChipTemps(room) is { } temps ? $"{temps} °C" : "—")
                            @if (active is not null)
                            {
                                <span> · @FormatActiveBoost(active)</span>
                            }
                        </MudText>
                    </div>
                    @if (_heatingNowBusyRoomId == room.Id)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-2" />
                    }
                    else
                    {
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Class="touch-target home-heating-now-btn"
                                   StartIcon="@EaseOffIcon(primaryEaseOff)"
                                   Disabled="@(heatingBusy || !CanEaseOff(room, primaryEaseOff))"
                                   OnClick="@(() => EaseOffRoomsAsync([room], primaryEaseOff))">
                            @EaseOffShortLabel(room, primaryEaseOff)
                        </MudButton>
                        @if (_easeOffPresets.Count > 1)
                        {
                            <MudMenu Icon="@Icons.Material.Filled.MoreVert"
                                     AriaLabel="@($"More ease-off options for {room.Name}")"
                                     AnchorOrigin="Origin.BottomRight"
                                     TransformOrigin="Origin.TopRight"
                                     Dense="true"
                                     Disabled="@heatingBusy">
                                @foreach (var preset in _easeOffPresets.Skip(1))
                                {
                                    <MudMenuItem Icon="@EaseOffIcon(preset)"
                                                 Disabled="@(!CanEaseOff(room, preset))"
                                                 OnClick="@(() => EaseOffRoomsAsync([room], preset))">
                                        @EaseOffShortLabel(room, preset)
                                    </MudMenuItem>
                                }
                            </MudMenu>
                        }
                    }
                </div>
            }
            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                Timed, then back to schedule. Change these buttons in Settings → Quick action presets.
            </MudText>
        </MudPaper>
    }

    <MudPaper Class="pa-5 hero-card">
        <MudTooltip Text="Polls your Wiser hub on the configured interval and records room data locally.">
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Live monitoring</MudChip>
        </MudTooltip>
        <MudText Typo="Typo.h4" Class="mt-2">Wiser Heat Hub Monitor</MudText>
        <MudText Typo="Typo.body1" Class="mt-1">
            Track room temperatures, heating demand, and trend charts from one dashboard designed for desktop and mobile.
        </MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-4">
            <MudButton Href="/rooms" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" Class="touch-target">
                Rooms
            </MudButton>
            <MudButton Href="/devices" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Memory" Class="touch-target">
                Devices
            </MudButton>
            <MudButton Href="/charts" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShowChart" Class="touch-target">
                Charts
            </MudButton>
            <MudButton Href="/settings" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" Class="touch-target">
                Settings
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 status-card home-quick-card">
        <div class="home-quick-header">
            <MudText Typo="Typo.h6">
                <i class="fa-solid fa-bolt"></i> Quick actions
            </MudText>
            @if (_liveDataAt is { } liveAt)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Live · @TimeZoneInfo.ConvertTime(liveAt, DisplayZone).ToString("t", CultureInfo.CurrentCulture)
                </MudText>
            }
        </div>
        @if (_quickActionRooms.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Live room controls are unavailable until the hub is reachable.
            </MudAlert>
        }
        else
        {
            var activeBoosts = ActiveBoostsNow();
            var cancelBusy = _quickActionsBusy || _cancelBoostBusyRoomId is not null;
            if (activeBoosts.Count > 0)
            {
                <div class="home-quick-section">
                    <div class="home-quick-section-head">
                        <span class="home-quick-label">Active now (@activeBoosts.Count)</span>
                        @if (activeBoosts.Count > 1)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Disabled="@cancelBusy"
                                       OnClick="@(() => CancelBoostsAsync(activeBoosts))">
                                Cancel all
                            </MudButton>
                        }
                    </div>
                    <div class="home-active-boost-list">
                        @foreach (var boost in activeBoosts)
                        {
                            <div class="home-active-boost-row">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Small" />
                                <div class="home-active-boost-text">
                                    <MudText Typo="Typo.body2"><strong>@boost.Name</strong></MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@FormatActiveBoost(boost)</MudText>
                                </div>
                                @if (_cancelBoostBusyRoomId == boost.RoomId)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-3" />
                                }
                                else
                                {
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               aria-label="@($"Extend {boost.Name} by 30 minutes")"
                                               Disabled="@(cancelBusy || TimedOverrideMath.ExtendMinutes(boost.EndUtc, DateTimeOffset.UtcNow) is null)"
                                               OnClick="@(() => ExtendBoostAsync(boost))">
                                        +30m
                                    </MudButton>
                                    <MudTooltip Text="@($"Cancel and return {boost.Name} to schedule")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Color="Color.Error"
                                                       Class="touch-target-icon"
                                                       aria-label="@($"Cancel boost for {boost.Name}")"
                                                       Disabled="@cancelBusy"
                                                       OnClick="@(() => CancelBoostsAsync([boost]))" />
                                    </MudTooltip>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="home-quick-section">
                <div class="home-quick-section-head">
                    <span class="home-quick-label">Rooms</span>
                    <div class="home-quick-select-actions">
                        @if (CallingHeatRoomCount > 0)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Warning"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.LocalFireDepartment"
                                       Disabled="_quickActionsBusy"
                                       OnClick="SelectCallingHeatRooms">
                                Calling heat (@CallingHeatRoomCount)
                            </MudButton>
                        }
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   Disabled="_quickActionsBusy"
                                   OnClick="ToggleAllBoostRooms">
                            @(AllBoostRoomsSelected ? "Clear" : "Select all")
                        </MudButton>
                    </div>
                </div>
                <div class="home-quick-chips">
                    @foreach (var room in _quickActionRooms)
                    {
                        var selected = _boostRoomNames.Contains(room.Name);
                        <MudChip T="string"
                                 Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                 Color="@(selected ? Color.Primary : Color.Default)"
                                 Icon="@(room.IsFavorite ? Icons.Material.Filled.Star : null)"
                                 IconColor="@(selected ? Color.Inherit : Color.Warning)"
                                 Disabled="_quickActionsBusy"
                                 title="@QuickRoomChipTitle(room)"
                                 OnClick="@(() => ToggleBoostRoom(room.Name))">
                            @if (room.CallingHeat)
                            {
                                <span class="home-chip-flame" aria-label="calling heat">🔥</span>
                            }
                            @room.Name
                            @if (QuickRoomChipTemps(room) is { } temps)
                            {
                                <span class="home-chip-temps">@temps</span>
                            }
                        </MudChip>
                    }
                </div>

                @if (_boostPresets.Count > 0 || QuickEaseOffPresets.Count > 0)
                {
                    <div class="home-quick-chips mt-2">
                        @foreach (var preset in _boostPresets)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(IsPresetSelected(preset) ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Secondary"
                                     Disabled="_quickActionsBusy"
                                     OnClick="@(() => SelectBoostPreset(preset))">
                                @($"{preset.Name} · {preset.TemperatureC:0.#}° · {FormatBoostDuration(preset.Minutes)}")
                            </MudChip>
                        }
                        @foreach (var easeOff in QuickEaseOffPresets)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(IsEaseOffSelected(easeOff) ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Info"
                                     Icon="@Icons.Material.Filled.TrendingDown"
                                     Disabled="_quickActionsBusy"
                                     OnClick="@(() => SelectEaseOffPreset(easeOff))">
                                @($"−{easeOff.DropC:0.#}° · {FormatBoostDuration(easeOff.Minutes)}")
                            </MudChip>
                        }
                    </div>
                }

                <div class="home-boost-settings">
                    <div>
                        <div class="home-target-head">
                            <span class="home-quick-label">@(_quickAdjustMode ? "Change by" : "Target")</span>
                            <div class="home-target-mode" role="radiogroup" aria-label="Target mode">
                                <MudButton Variant="@(_quickAdjustMode ? Variant.Text : Variant.Filled)"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           DropShadow="false"
                                           role="radio"
                                           aria-checked="@(_quickAdjustMode ? "false" : "true")"
                                           Disabled="_quickActionsBusy"
                                           OnClick="@(() => _quickAdjustMode = false)">
                                    Set °C
                                </MudButton>
                                <MudButton Variant="@(_quickAdjustMode ? Variant.Filled : Variant.Text)"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           DropShadow="false"
                                           role="radio"
                                           aria-checked="@(_quickAdjustMode ? "true" : "false")"
                                           Disabled="_quickActionsBusy"
                                           OnClick="@(() => _quickAdjustMode = true)">
                                    Adjust ±
                                </MudButton>
                            </div>
                        </div>
                        @if (_quickAdjustMode)
                        {
                            <div class="home-temp-stepper">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Class="touch-target-icon"
                                               aria-label="Change by 0.5 °C less"
                                               Disabled="@(_quickActionsBusy || _quickAdjustDeltaC <= -QuickAdjustDeltaMax)"
                                               OnClick="@(() => StepQuickAdjustDelta(-0.5))" />
                                <div class="home-temp-value" aria-live="polite">
                                    @FormatDelta(_quickAdjustDeltaC)<span class="home-temp-unit">°C</span>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Class="touch-target-icon"
                                               aria-label="Change by 0.5 °C more"
                                               Disabled="@(_quickActionsBusy || _quickAdjustDeltaC >= QuickAdjustDeltaMax)"
                                               OnClick="@(() => StepQuickAdjustDelta(0.5))" />
                            </div>
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">
                                From each room's current target.
                            </MudText>
                        }
                        else
                        {
                            <div class="home-temp-stepper">
                                <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Class="touch-target-icon"
                                               aria-label="Lower target by 0.5 °C"
                                               Disabled="@(_quickActionsBusy || QuickBoostTempClamped <= QuickBoostTempMin)"
                                               OnClick="@(() => StepQuickBoostTemp(-0.5))" />
                                <div class="home-temp-value" aria-live="polite">
                                    @QuickBoostTempClamped.ToString("F1", CultureInfo.CurrentCulture)<span class="home-temp-unit">°C</span>
                                </div>
                                <MudIconButton Icon="@Icons.Material.Filled.Add"
                                               Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Class="touch-target-icon"
                                               aria-label="Raise target by 0.5 °C"
                                               Disabled="@(_quickActionsBusy || QuickBoostTempClamped >= QuickBoostTempMax)"
                                               OnClick="@(() => StepQuickBoostTemp(0.5))" />
                            </div>
                        }
                    </div>
                    <div>
                        <span class="home-quick-label">Duration</span>
                        <div class="home-duration-grid" role="radiogroup" aria-label="Boost duration">
                            @foreach (var m in QuickBoostDurationOptions)
                            {
                                var selected = _quickBoostMinutes == m;
                                <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           DropShadow="false"
                                           role="radio"
                                           aria-checked="@(selected ? "true" : "false")"
                                           aria-label="@FormatBoostDuration(m)"
                                           Disabled="_quickActionsBusy"
                                           OnClick="@(() => _quickBoostMinutes = m)">
                                    @FormatBoostDurationShort(m)
                                </MudButton>
                            }
                            @{
                                var untilNextSelected = _quickBoostMinutes == QuickActionPresets.UntilNextChange;
                            }
                            <MudButton Variant="@(untilNextSelected ? Variant.Filled : Variant.Outlined)"
                                       Color="Color.Primary"
                                       DropShadow="false"
                                       Class="home-duration-next"
                                       StartIcon="@Icons.Material.Filled.Schedule"
                                       role="radio"
                                       aria-checked="@(untilNextSelected ? "true" : "false")"
                                       aria-label="Until each room's next schedule change"
                                       Disabled="_quickActionsBusy"
                                       OnClick="@(() => _quickBoostMinutes = QuickActionPresets.UntilNextChange)">
                                Until next schedule change
                            </MudButton>
                        </div>
                        @if (untilNextSelected && UntilNextChangeSummary is { } untilSummary)
                        {
                            <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mt-1">@untilSummary</MudText>
                        }
                    </div>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@(_quickActionsBusy ? null : QuickApplyIcon)"
                           Class="touch-target mt-3"
                           Disabled="@QuickApplyDisabled"
                           OnClick="ApplyQuickBoostAsync">
                    @if (_quickActionsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @QuickBoostButtonText
                </MudButton>
            </div>
        }

        <MudDivider Class="mt-4" />
        <div class="home-quick-secondary">
            <MudButton Variant="Variant.Outlined"
                       Color="@(AwayQuickActionShowsActive ? Color.Warning : Color.Primary)"
                       StartIcon="@(AwayQuickActionShowsActive ? Icons.Material.Filled.Home : Icons.Material.Filled.FlightTakeoff)"
                       Class="touch-target"
                       Disabled="@(_quickActionsBusy || _quickActionRooms.Count == 0)"
                       OnClick="@ToggleAwayModeAsync">
                @(AwayQuickActionShowsActive ? "Return home" : "Set away")
            </MudButton>
            <MudButton Href="/gas-meter"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.LocalGasStation"
                       Class="touch-target">
                Gas reading
            </MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 status-card">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">
                <i class="fa-solid fa-grip"></i> Room temperatures &amp; trend
            </MudText>
            <MudButton Href="/charts"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.OpenInNew">
                Charts
            </MudButton>
        </MudStack>
        @if (_homeRoomTiles.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">No room trend data yet.</MudAlert>
        }
        else
        {
            <div class="room-heat-grid home-room-heat-grid mt-2">
                @foreach (var tile in _homeRoomTiles)
                {
                    <a class="room-heat-tile room-heat-link"
                       style="background-color:@tile.Color;"
                       href="@GetRoomDetailsHref(tile.Room)"
                       title="@($"Open {tile.Room} in Rooms")">
                        <div class="room-heat-name">
                            <span class="room-heat-state-square" style="background-color:@tile.CurrentStateColor;" title="@tile.CurrentStateText"></span>
                            @tile.Room
                        </div>
                        <div class="room-heat-temp">@tile.DisplayTemp</div>
                        <div class="room-heat-meta room-heat-meta-status">@tile.StatusText</div>
                        <div class="room-heat-meta d-none d-sm-block">@tile.TrendText</div>
                    </a>
                }
            </div>
        }
    </MudPaper>

    <MudExpansionPanels Class="home-expansion-panels">

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-map-location-dot"></i> Floorplan temperature overlay</MudText>
            </TitleContent>
            <ChildContent>
                <MudButton Href="/settings" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew" Class="mb-1 pa-0">
                    Configure in Settings
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Room pins are mapped in Settings. Colors reflect temperature vs each room's recommended range. A flame before the temperature means the room is calling for heat (hub demand). Icons after the temperature compare the latest reading to the previous poll (warmer, cooler, or steady).
                </MudText>
                @if (FloorplanImageHref is null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Upload a floorplan image and map room pins in Settings to enable this view.
                    </MudAlert>
                }
                else if (_homeFloorplanPins.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        No room pins are mapped yet. Add pin coordinates in Settings.
                    </MudAlert>
                }
                else
                {
                    <div class="home-floorplan-wrap">
                        <img src="@FloorplanImageHref" alt="House floorplan" class="home-floorplan-image" />
                        @foreach (var pin in _homeFloorplanPins)
                        {
                            <a class="home-floorplan-pin"
                               href="@GetRoomDetailsHref(pin.Room)"
                               style="@($"left:{pin.XPercent:0.##}%;top:{pin.YPercent:0.##}%;--pin-color:{pin.Color};")"
                               title="@pin.Tooltip"
                               aria-label="@pin.Tooltip">
                                <span class="home-floorplan-pin-dot"></span>
                                <span class="home-floorplan-pin-label">
                                    <span class="home-floorplan-pin-room">@pin.Room</span><span class="home-floorplan-pin-sep">: </span>
                                    <span class="home-floorplan-pin-temp-group">
                                        @if (pin.CallingForHeat)
                                        {
                                            <i class="fa-solid fa-fire-flame-curved home-floorplan-pin-heat-icon" aria-hidden="true"></i>
                                        }
                                        <span class="home-floorplan-pin-temp">@pin.TempText</span>
                                        @if (pin.TrendIconClass is not null)
                                        {
                                            <i class="@pin.TrendIconClass home-floorplan-pin-trend-icon" aria-hidden="true"></i>
                                        }
                                    </span>
                                </span>
                            </a>
                        }
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-cloud-sun"></i> Heating demand outlook</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Compares last 7 local days of HDD (from stored outdoor samples) to the next 7 days from Open-Meteo forecast daily temperatures. Same 15.5 °C base as the daily summary. Not a bill forecast.
                </MudText>
                @if (Options.OpenMeteoLat is null || Options.OpenMeteoLon is null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Configure Open-Meteo latitude and longitude on Settings to enable this outlook.
                    </MudText>
                }
                else if (_outlookLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1" />
                }
                else if (!string.IsNullOrWhiteSpace(_outlookError))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@_outlookError</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body1">@_outlookSummary</MudText>
                    @if (!string.IsNullOrWhiteSpace(_outlookDetail))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">@_outlookDetail</MudText>
                    }
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-table"></i> Daily summary (energy proxies)</MudText>
            </TitleContent>
            <ChildContent>
                <MudButton Href="/charts" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew" Class="mb-1 pa-0">
                    Open Charts
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Per local day: HDD (15.5 °C base), mean outdoor °C, and heating demand / boiler relay minutes estimated from poll activity. Needs outdoor samples for HDD columns.
                </MudText>
                @if (_homeDailyRows.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No daily summary rows yet (needs recorded history).</MudAlert>
                }
                else
                {
                    <MudTable T="DailySummaryRow" Items="_homeDailyRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh Class="text-right">HDD</MudTh>
                            <MudTh Class="text-right">Avg out °C</MudTh>
                            <MudTh Class="text-right">Heat est. min</MudTh>
                            <MudTh Class="text-right">Relay est. min</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Date</MudTd>
                            <MudTd DataLabel="HDD" Class="text-right">@FmtOpt(context.Hdd)</MudTd>
                            <MudTd DataLabel="Avg out" Class="text-right">@FmtOpt(context.AvgOutdoorC)</MudTd>
                            <MudTd DataLabel="Heat min" Class="text-right">@FmtHeatMin(context.HeatingActiveEstimateMin)</MudTd>
                            <MudTd DataLabel="Relay min" Class="text-right">@FmtHeatMin(context.HeatingRelayEstimateMin)</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudButton Href="/api/export/daily-summary.csv?days=14"
                               Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download" Class="mt-1">
                        Export CSV (14 days)
                    </MudButton>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-piggy-bank"></i> Save on heating</MudText>
            </TitleContent>
            <ChildContent>
                <MudButton Href="/settings" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Tune" Class="mb-1 pa-0">
                    Customise routine
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Suggestions are heuristics from your routine profile, recent heating activity, forecast context, and schedule mapping when hub data is available.
                </MudText>
                @if (_savingsSuggestions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No suggestions yet.</MudAlert>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var tip in _savingsSuggestions)
                        {
                            <MudAlert Severity="@(tip.Level == HeatingSavingsSuggestionLevel.Warning ? Severity.Warning : Severity.Info)" Dense="true">
                                <div class="d-flex flex-wrap align-center" style="gap: 10px;">
                                    <MudText Typo="Typo.body2" Class="flex-grow-1">
                                        <strong>@tip.Title:</strong> @tip.Body
                                    </MudText>
                                    <MudButton Href="@tip.ActionHref" Variant="Variant.Text" Size="Size.Small"
                                               Color="Color.Primary" EndIcon="@Icons.Material.Filled.OpenInNew">
                                        @tip.ActionText
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                    </MudStack>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-filter-circle-xmark"></i> Data quality (last 24h)</MudText>
            </TitleContent>
            <ChildContent>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                    <MudTooltip Text="Invalid hub readings not stored in history (last 24h).">
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">
                            Dropped invalid readings: @_qualityTotal24h
                        </MudChip>
                    </MudTooltip>
                    @foreach (var item in _qualityReasons24h)
                    {
                        <MudTooltip Text="Why samples were dropped.">
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">
                                @($"{item.Reason}: {item.Count}")
                            </MudChip>
                        </MudTooltip>
                    }
                </MudStack>
                <MudButton Href="/charts#data-quality" Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.OpenInNew">
                    View details
                </MudButton>
            </ChildContent>
        </MudExpansionPanel>

    </MudExpansionPanels>
</MudStack>

<div class="home-sticky-actionbar">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@QuickApplyIcon"
               Class="touch-target"
               Disabled="@QuickApplyDisabled"
               OnClick="ApplyQuickBoostAsync">
        @($"{QuickApplyVerb} {FormatRoomCount(SelectedBoostRoomCount)}")
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="@(AwayQuickActionShowsActive ? Color.Warning : Color.Primary)"
               StartIcon="@(AwayQuickActionShowsActive ? Icons.Material.Filled.Home : Icons.Material.Filled.FlightTakeoff)"
               Class="touch-target"
               Disabled="@(_quickActionsBusy || _quickActionRooms.Count == 0)"
               OnClick="@ToggleAwayModeAsync">
        @(AwayQuickActionShowsActive ? "Return home" : "Set away")
    </MudButton>
</div>

@code {
    private const int HomeTrendHours = 24;
    private string _status = "Loading...";
    private string? _lastError;
    private int _qualityTotal24h;
    private List<DataQualityReasonCount> _qualityReasons24h = [];
    private readonly List<HomeRoomHeatTile> _homeRoomTiles = [];
    /// <summary>Last two stored polls per room, captured by <see cref="BuildHomeRoomHeatMap"/> for floorplan trend icons.</summary>
    private readonly Dictionary<string, (double Prev, double Last)> _lastTwoTempsByRoom = new(StringComparer.OrdinalIgnoreCase);

    private bool _outlookLoading;
    private string? _outlookError;
    private string _outlookSummary = "";
    private string? _outlookDetail;
    private readonly List<HeatingSavingsSuggestion> _savingsSuggestions = [];
    private readonly List<DailySummaryRow> _homeDailyRows = [];
    private readonly List<QuickActionRoom> _quickActionRooms = [];
    private readonly List<AwayRoomSnapshot> _awayModeSnapshot = [];
    private HashSet<string> _boostRoomNames = new(StringComparer.OrdinalIgnoreCase);
    private const double QuickBoostTempMin = 5.0;
    private const double QuickBoostTempMax = 30.0;
    private double _quickBoostTempC = 21.0;
    private int _quickBoostMinutes = 30;
    private static readonly int[] QuickBoostDurationOptions = [15, 30, 45, 60, 90, 120, 180, 240];
    private const string QuickBoostTempStorageKey = "wiser-home-boost-temp";
    private const string QuickBoostMinutesStorageKey = "wiser-home-boost-minutes";
    private IReadOnlyList<BoostPresetInfo> _boostPresets = [];
    private IReadOnlyList<EaseOffPreset> _easeOffPresets = [];
    /// <summary>When true the stepper is a change from each room's own target rather than one °C for all.</summary>
    private bool _quickAdjustMode;
    private double _quickAdjustDeltaC = -1.0;
    private const double QuickAdjustDeltaMax = 10.0;
    private const string QuickAdjustModeStorageKey = "wiser-home-boost-adjust-mode";
    private const string QuickAdjustDeltaStorageKey = "wiser-home-boost-adjust-delta";
    /// <summary>Rooms with a timed override still running on the hub, from the latest live overview.</summary>
    private readonly List<ActiveBoost> _activeBoosts = [];
    private int? _cancelBoostBusyRoomId;
    private bool _quickActionsBusy;
    private bool _awayModeActive;
    /// <summary>Hub whole-house away (<see cref="HubLiveOverview.SystemAway"/>), distinct from quick-action "all rooms auto" state.</summary>
    private bool _hubSystemAway;
    private const string AwayModeActiveStorageKey = "wiser-away-active";
    private const string AwayModeSnapshotStorageKey = "wiser-away-snapshot";
    private FloorplanConfig _homeFloorplanConfig = FloorplanConfig.Default;
    private readonly List<HomeFloorplanPin> _homeFloorplanPins = [];
    /// <summary>Live hub °C per room (same source as <c>/rooms</c>); merged onto DB-backed tiles/floorplan.</summary>
    private Dictionary<string, HubLiveRoom>? _liveHubByRoom;
    /// <summary>When the live hub snapshot shown on this page was taken (shared cache or own fetch).</summary>
    private DateTimeOffset? _liveDataAt;
    private double? _outlookPastWeekHddSum;
    private double? _outlookForecastWeekHddSum;

    private string? _gasMeterReadingBannerText;
    private PeriodicTimer? _homeUiRefreshTimer;
    private CancellationTokenSource? _homeUiRefreshCts;
    private Guid? _extendPromptShownForSession;
    private bool _timedAwayActionBusy;
    private string? _homeTrendBuildError;
    private BoilerCycleSummary? _homeBoilerSummary;
    private DateTime? _awayPromptEndDate;
    private TimeSpan? _awayPromptEndTime = new TimeSpan(18, 0, 0);

    private bool HubConfiguredForApi => HubConfiguration.IsConfigured(Options);

    private TimeZoneInfo DisplayZone => TimeZoneResolver.Resolve(Options.TimeZoneId);
    private string? FloorplanImageHref =>
        string.IsNullOrWhiteSpace(_homeFloorplanConfig.ImageFileName)
            ? null
            : $"/api/floorplan/image?v={_homeFloorplanConfig.UpdatedTs}";

    private bool AwayQuickActionShowsActive =>
        _awayModeActive || _hubSystemAway || Store.TryGetActiveTimedAwaySession() is not null;

    protected override Task OnInitializedAsync()
    {
        var (err, ok) = MonitorState.Snapshot();
        _lastError = err;
        var okText = ok is null
            ? "No successful poll yet."
            : $"Last OK: {TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(ok.Value), DisplayZone).ToString("g", CultureInfo.CurrentCulture)}";
        _status = $"Poll interval: {Options.IntervalSec}s · Alerts: {(Options.AlertsEnabled ? "On" : "Off")} · {okText}";


        // Use the last cached hub snapshot for instant render; fresh data arrives via LoadLiveDataAsync after first render.
        if (RoomsCache.TryGetSnapshot(out var cached, out var cachedAt))
        {
            _liveDataAt = cachedAt;
            _hubSystemAway = cached.SystemAway;
            PopulateQuickActionRooms(cached);
            _liveHubByRoom = LiveHubRoomTemps.ToAvailableTempByRoomName(cached);
        }

        var presets = Store.GetQuickActionPresets();
        _boostPresets = presets.Boosts;
        _easeOffPresets = presets.EaseOffs;
        _roomRanges = Store.GetRoomRanges();
        var quality = Store.GetDataQualitySummary(24);
        _qualityTotal24h = quality.TotalIgnored;
        _qualityReasons24h = quality.ByReason.Take(4).ToList();
        LoadHomeDailySummary();
        BuildHomeRoomHeatMap();
        BuildHomeFloorplanOverlay();
        UpdateGasMeterReadingBanner();
        LoadHomeBoilerSummary();
        return Task.CompletedTask;
    }

    /// <param name="resetSelection">False after an action, so fresh targets show without losing the chosen rooms.</param>
    private void PopulateQuickActionRooms(HubLiveOverview overview, bool resetSelection = true)
    {
        var favoriteRooms = Store.GetHeatingSavingsProfile()
            .PriorityRooms
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        _quickActionRooms.Clear();
        _quickActionRooms.AddRange(overview.Rooms
            .Where(static r => r.Id > 0)
            .Select(r =>
            {
                var modeKey = ResolveModeKey(r.Mode, r.SetpointC);
                var manualTemp = modeKey == "manual" && r.SetpointC is >= 5.0 and var sp
                    ? WiserSetpointDisplay.ToDisplayTargetC(sp)
                    : (double?)null;
                var targetC = r.SetpointC is { } target && !WiserSetpointDisplay.IsHubOffSentinel(target)
                    ? target
                    : (double?)null;
                var tempC = Math.Abs(r.TempC - (-327.68)) < 0.001 ? (double?)null : r.TempC;
                return new QuickActionRoom(r.Id, r.Name, favoriteRooms.Contains(r.Name), modeKey, manualTemp,
                    tempC, targetC, r.HeatDemand != 0, r.NextScheduleChangeUnix);
            })
            .OrderByDescending(static r => r.IsFavorite)
            .ThenBy(static r => r.Name, StringComparer.OrdinalIgnoreCase));
        PopulateActiveBoosts(overview);
        if (!resetSelection)
            return;
        _boostRoomNames = _quickActionRooms
            .Where(static r => r.IsFavorite)
            .Select(static r => r.Name)
            .ToHashSet(StringComparer.OrdinalIgnoreCase);
        if (_boostRoomNames.Count == 0)
        {
            _boostRoomNames = _quickActionRooms
                .Select(static r => r.Name)
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
        }
    }

    private void LoadHomeBoilerSummary()
    {
        var since = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - HomeTrendHours * 3600L;
        _homeBoilerSummary = BoilerCycleAnalyzer.Summarize(Store.SeriesSystem(since), 5.0);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender)
            return;
        // JS interop (localStorage) requires a live circuit; must run here, not in OnInitializedAsync.
        await TryLoadAwayStateAsync();
        if (await TryLoadQuickBoostSettingsAsync())
            StateHasChanged();
        _homeUiRefreshCts = new CancellationTokenSource();
        _homeUiRefreshTimer = new PeriodicTimer(TimeSpan.FromSeconds(45));
        _ = PumpHomeUiRefreshAsync();
        _ = LoadLiveDataAsync();
    }

    private async Task LoadLiveDataAsync()
    {
        // Start the hub fetch, 14-day summaries and weather outlook together; none depend on each other.
        // A fresh app-wide snapshot (poller or another page) skips the hub round trip entirely.
        // One hub fetch feeds both the live overview and the savings hints.
        var cacheFresh = RoomsCache.TryGetFresh(LiveCacheMaxAge, out var cachedOverview, out var cachedHints);
        var hubTask = cacheFresh
            ? Task.FromResult<(HubLiveOverview?, HubScheduleSavingsHints?)>((cachedOverview, cachedHints))
            : LiveHubRoomTemps.TryFetchOverviewWithSavingsHintsAsync(Hub, Options, CancellationToken.None);
        var dailyTask = Task.Run(() =>
            Store.GetDailySummaries(14, Math.Max(10, Options.IntervalSec), DisplayZone));
        var outlookTask = StartOutlookFetch();

        // Render live room data as soon as the hub answers, without waiting on Open-Meteo.
        var (liveOverview, hubHints) = await hubTask.ConfigureAwait(false);
        hubHints ??= cachedHints;
        if (liveOverview is not null && !cacheFresh)
        {
            await InvokeAsync(() =>
            {
                _hubSystemAway = liveOverview.SystemAway;
                RoomsCache.Update(liveOverview, hubHints);
                _liveDataAt = DateTimeOffset.Now;
                PopulateQuickActionRooms(liveOverview);
                _liveHubByRoom = LiveHubRoomTemps.ToAvailableTempByRoomName(liveOverview);
                BuildHomeRoomHeatMap();
                BuildHomeFloorplanOverlay();
                StateHasChanged();
            });
        }

        var sharedDaily = await dailyTask.ConfigureAwait(false);
        await InvokeAsync(async () =>
        {
            LoadHomeDailySummary(sharedDaily);
            await LoadHeatingOutlookAsync(sharedDaily, outlookTask);
            LoadSavingsSuggestions(sharedDaily, hubHints);
            StateHasChanged();
            await TryPromptExtendNearEndOnceAsync();
        });
    }

    /// <summary>Snapshots younger than this are used as-is on load; older ones render immediately and refresh from the hub.</summary>
    private static readonly TimeSpan LiveCacheMaxAge = TimeSpan.FromSeconds(60);

    private Task<SevenDayHddOutlook?>? StartOutlookFetch() =>
        Options.OpenMeteoLat is { } lat && Options.OpenMeteoLon is { } lon
            ? OutdoorWeather.GetSevenDayHddOutlookAsync(lat, lon, Options.TimeZoneId, CancellationToken.None)
            : null;

    private async Task PumpHomeUiRefreshAsync()
    {
        try
        {
            while (_homeUiRefreshTimer is not null &&
                   await _homeUiRefreshTimer.WaitForNextTickAsync(_homeUiRefreshCts?.Token ?? default))
            {
                await InvokeAsync(RefreshHomeTimedAwayStateAsync);
            }
        }
        catch (OperationCanceledException)
        {
            // ignore
        }
    }

    private async Task RefreshHomeTimedAwayStateAsync()
    {
        var session = Store.TryGetActiveTimedAwaySession();
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        if (session is not null && now >= session.EndsAtUnix && HubConfiguredForApi)
        {
            try
            {
                using var resp = await Http.PostAsync("/api/away/expire-due", null);
                if (!resp.IsSuccessStatusCode)
                    Snackbar.Add("Could not restore Home on the hub yet; will retry.", Severity.Warning);
            }
            catch
            {
                // retry on next tick
            }
        }

        if (HubConfiguredForApi)
        {
            try
            {
                // No ConfigureAwait(false): the rest of this method mutates state and calls StateHasChanged on the dispatcher.
                var overview = await LiveHubRoomTemps.TryFetchOverviewAsync(Hub, Options, CancellationToken.None);
                if (overview is not null)
                {
                    RoomsCache.Update(overview);
                    _liveDataAt = DateTimeOffset.Now;
                    _hubSystemAway = overview.SystemAway;
                    _liveHubByRoom = LiveHubRoomTemps.ToAvailableTempByRoomName(overview);
                    // Keeps "Heating now" and the room chips current without losing the chosen rooms.
                    PopulateQuickActionRooms(overview, resetSelection: false);
                }
            }
            catch
            {
                // ignore
            }
        }

        try
        {
            BuildHomeRoomHeatMap();
            BuildHomeFloorplanOverlay();
        }
        catch (Exception ex)
        {
            _homeTrendBuildError = ex.Message;
        }

        LoadHomeBoilerSummary();
        StateHasChanged();
    }

    public async ValueTask DisposeAsync()
    {
        _homeUiRefreshCts?.Cancel();
        _homeUiRefreshCts?.Dispose();
        _homeUiRefreshTimer?.Dispose();
        await Task.CompletedTask;
    }

    private string FormatTimedAwayLocal(long unix)
    {
        var z = DisplayZone;
        var local = TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unix), z);
        return local.ToString("g", CultureInfo.CurrentCulture);
    }

    private string FormatTimedAwayBannerSummary(TimedAwaySessionRow session)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var localEnd = FormatTimedAwayLocal(session.EndsAtUnix);
        if (now >= session.EndsAtUnix)
        {
            var ago = TimeSpan.FromSeconds(now - session.EndsAtUnix);
            return $"ended {FormatTimedAwayRelative(ago)} ago ({localEnd}) — restoring Home on the hub";
        }

        var until = TimeSpan.FromSeconds(session.EndsAtUnix - now);
        return $"until {localEnd} ({FormatTimedAwayRelative(until)} left)";
    }

    private static string FormatTimedAwayRelative(TimeSpan span)
    {
        if (span.TotalMinutes < 1)
            return "under 1 min";
        if (span.TotalHours < 1)
            return $"{(int)Math.Round(span.TotalMinutes)} min";
        if (span.TotalDays < 1)
            return $"{span.Hours}h {span.Minutes}m";
        return $"{(int)span.TotalDays}d {span.Hours}h";
    }

    private async Task TryPromptExtendNearEndOnceAsync()
    {
        var s = Store.TryGetActiveTimedAwaySession();
        if (s is null)
            return;
        var policy = Store.GetTimedAwayPolicy();
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var leadSec = Math.Max(1, policy.ExtensionLeadMinutes) * 60L;
        if (now < s.EndsAtUnix - leadSec || now >= s.EndsAtUnix)
            return;
        if (_extendPromptShownForSession == s.SessionId)
            return;
        _extendPromptShownForSession = s.SessionId;
        var endLocal = TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(s.EndsAtUnix), DisplayZone);
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Extend away mode?",
            $"Monitor away ends at {endLocal:g} ({DisplayZone.Id}). Add one hour?",
            yesText: "Extend 1 hour",
            cancelText: "Not now");
        if (confirm == true)
            await QuickExtendTimedAwayAsync(60);
    }

    private async Task QuickExtendTimedAwayAsync(int minutes)
    {
        _timedAwayActionBusy = true;
        try
        {
            using var resp = await Http.PostAsJsonAsync("/api/away/extend", new { extend_minutes = minutes });
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add(await resp.Content.ReadAsStringAsync(), Severity.Warning);
                return;
            }

            Snackbar.Add($"Away extended by {minutes} minutes.", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _timedAwayActionBusy = false;
        }
    }

    private async Task CancelMonitorTimedAwayAsync()
    {
        _timedAwayActionBusy = true;
        try
        {
            using var resp = await Http.PostAsync("/api/away/cancel", null);
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add(await resp.Content.ReadAsStringAsync(), Severity.Warning);
                return;
            }

            Snackbar.Add("Timed away cancelled; hub set to Home.", Severity.Success);
            await RefreshHomeTimedAwayStateAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
        finally
        {
            _timedAwayActionBusy = false;
        }
    }

    private void LoadHomeDailySummary(IReadOnlyList<DailySummaryRow>? shared = null)
    {
