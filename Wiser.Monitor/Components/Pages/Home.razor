@page "/"
@rendermode InteractiveServer
@using System.Globalization
@using System.Net.Http.Json
@using System.Text.Json
@using Microsoft.JSInterop
@using Wiser.Monitor.Services
@implements IAsyncDisposable

@inject MonitorState MonitorState
@inject MonitorOptions Options
@inject TemperatureStore Store
@inject OutdoorWeatherClient OutdoorWeather
@inject WiserHubFetch Hub
@inject RoomsLiveDataCache RoomsCache
@inject HttpClient Http
@inject ISnackbar Snackbar
@inject IJSRuntime Js
@inject IDialogService DialogService

<PageTitle>Wiser Monitor</PageTitle>

<MudStack Spacing="3" Class="home-page-stack">
    @if (MonitorState.LowBatteryDevices.Count > 0)
    {
        <MudAlert Severity="Severity.Warning" Dense="true" ShowCloseIcon="false"
                  ContentAlignment="HorizontalAlignment.Left">
            <div class="d-flex flex-wrap align-center" style="gap: 12px;">
                <MudText Typo="Typo.body1" Class="flex-grow-1">
                    Low battery (&lt;20%): @string.Join(", ", MonitorState.LowBatteryDevices)
                </MudText>
                <MudButton Href="/devices" Variant="Variant.Filled" Color="Color.Warning"
                           Size="Size.Small" StartIcon="@Icons.Material.Filled.Battery1Bar"
                           Class="touch-target">
                    Devices
                </MudButton>
            </div>
        </MudAlert>
    }
    @if (_gasMeterReadingBannerText is not null)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true"
                  Class="home-gas-meter-banner"
                  ShowCloseIcon="false"
                  ContentAlignment="HorizontalAlignment.Left">
            <div class="d-flex flex-wrap align-center" style="gap: 12px;">
                <MudText Typo="Typo.body1" Class="flex-grow-1">@_gasMeterReadingBannerText</MudText>
                <MudButton Href="/gas-meter"
                           Variant="Variant.Filled"
                           Color="Color.Warning"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.LocalGasStation"
                           Class="touch-target">
                    Gas meter
                </MudButton>
            </div>
        </MudAlert>
    }

    @{
        var timedAway = Store.TryGetActiveTimedAwaySession();
        var timedAwayOverdue = timedAway is not null
            && DateTimeOffset.UtcNow.ToUnixTimeSeconds() >= timedAway.EndsAtUnix;
    }
    @if (_hubSystemAway && timedAway is null)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true"
                  Class="home-hub-away-banner"
                  ShowCloseIcon="false">
            <MudText Typo="Typo.body2">
                <strong>Hub away mode</strong> is active (set outside this monitor schedule).
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@(_quickActionsBusy || !HubConfiguredForApi)"
                           OnClick="@ToggleAwayModeAsync">
                    Return Home
                </MudButton>
            </MudText>
        </MudAlert>
    }
    @if (timedAway is not null)
    {
        <MudAlert Severity="@(timedAwayOverdue ? Severity.Warning : Severity.Info)"
                  Dense="true"
                  Class="home-timed-away-banner"
                  ShowCloseIcon="false">
            <MudText Typo="Typo.body2">
                <span><strong>@(timedAwayOverdue ? "Timed away ended" : "Timed away")</strong> — @FormatTimedAwayBannerSummary(timedAway)</span>
                (@timedAway.Source, limit @timedAway.AwayLimitC.ToString("F1", CultureInfo.InvariantCulture) °C).
                <MudLink Href="/settings">Settings</MudLink>
                ·
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(60))">
                    +1h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(180))">
                    +3h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(360))">
                    +6h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@_timedAwayActionBusy"
                           OnClick="@(() => QuickExtendTimedAwayAsync(540))">
                    +9h
                </MudButton>
                <MudButton Variant="Variant.Text"
                           Color="Color.Error"
                           Size="Size.Small"
                           Class="pa-0 ma-0"
                           Disabled="@(_timedAwayActionBusy || !HubConfiguredForApi)"
                           OnClick="@CancelMonitorTimedAwayAsync">
                    Cancel
                </MudButton>
            </MudText>
        </MudAlert>
    }

    @if (!string.IsNullOrWhiteSpace(_homeTrendBuildError))
    {
        <MudAlert Severity="Severity.Error" Dense="true" Class="home-trend-error-banner">
            Room trend tiles failed to build: @_homeTrendBuildError
        </MudAlert>
    }

    @if (_homeBoilerSummary is { ShortCycleRatio: >= 0.35 } boil)
    {
        <MudAlert Severity="Severity.Warning"
                  Dense="true"
                  Class="home-boiler-cycle-banner"
                  ShowCloseIcon="false">
            <MudText Typo="Typo.body2">
                Boiler short-cycle ratio is high over the last @HomeTrendHours h (@boil.ShortCycleRatioText, threshold @boil.ShortCycleThresholdMin.ToString("F0", CultureInfo.InvariantCulture) min).
                <MudLink Href="/charts">Open Charts</MudLink> for cycle detail.
            </MudText>
        </MudAlert>
    }

    <MudPaper Class="pa-5 hero-card">
        <MudTooltip Text="Polls your Wiser hub on the configured interval and records room data locally.">
            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small">Live monitoring</MudChip>
        </MudTooltip>
        <MudText Typo="Typo.h4" Class="mt-2">Wiser Heat Hub Monitor</MudText>
        <MudText Typo="Typo.body1" Class="mt-1">
            Track room temperatures, heating demand, and trend charts from one dashboard designed for desktop and mobile.
        </MudText>
        <MudStack Row="true" Spacing="1" Wrap="Wrap.Wrap" Class="mt-4">
            <MudButton Href="/rooms" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Home" Class="touch-target">
                Rooms
            </MudButton>
            <MudButton Href="/devices" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Memory" Class="touch-target">
                Devices
            </MudButton>
            <MudButton Href="/charts" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.ShowChart" Class="touch-target">
                Charts
            </MudButton>
            <MudButton Href="/settings" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Settings" Class="touch-target">
                Settings
            </MudButton>
        </MudStack>
    </MudPaper>

    <MudPaper Class="pa-4 status-card home-quick-card">
        <div class="home-quick-header">
            <MudText Typo="Typo.h6">
                <i class="fa-solid fa-bolt"></i> Quick actions
            </MudText>
            @if (_liveDataAt is { } liveAt)
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">
                    Live · @TimeZoneInfo.ConvertTime(liveAt, DisplayZone).ToString("t", CultureInfo.CurrentCulture)
                </MudText>
            }
        </div>
        @if (_quickActionRooms.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">
                Live room controls are unavailable until the hub is reachable.
            </MudAlert>
        }
        else
        {
            var activeBoosts = ActiveBoostsNow();
            var cancelBusy = _quickActionsBusy || _cancelBoostBusyRoomId is not null;
            if (activeBoosts.Count > 0)
            {
                <div class="home-quick-section">
                    <div class="home-quick-section-head">
                        <span class="home-quick-label">Active now (@activeBoosts.Count)</span>
                        @if (activeBoosts.Count > 1)
                        {
                            <MudButton Variant="Variant.Text"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       Disabled="@cancelBusy"
                                       OnClick="@(() => CancelBoostsAsync(activeBoosts))">
                                Cancel all
                            </MudButton>
                        }
                    </div>
                    <div class="home-active-boost-list">
                        @foreach (var boost in activeBoosts)
                        {
                            <div class="home-active-boost-row">
                                <MudIcon Icon="@Icons.Material.Filled.Bolt" Color="Color.Warning" Size="Size.Small" />
                                <div class="home-active-boost-text">
                                    <MudText Typo="Typo.body2"><strong>@boost.Name</strong></MudText>
                                    <MudText Typo="Typo.caption" Class="mud-text-secondary">@FormatActiveBoost(boost)</MudText>
                                </div>
                                @if (_cancelBoostBusyRoomId == boost.RoomId)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="ma-3" />
                                }
                                else
                                {
                                    <MudTooltip Text="@($"Cancel and return {boost.Name} to schedule")">
                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                       Color="Color.Error"
                                                       Class="touch-target-icon"
                                                       aria-label="@($"Cancel boost for {boost.Name}")"
                                                       Disabled="@cancelBusy"
                                                       OnClick="@(() => CancelBoostsAsync([boost]))" />
                                    </MudTooltip>
                                }
                            </div>
                        }
                    </div>
                </div>
            }

            <div class="home-quick-section">
                <div class="home-quick-section-head">
                    <span class="home-quick-label">Boost rooms</span>
                    <MudButton Variant="Variant.Text"
                               Color="Color.Primary"
                               Size="Size.Small"
                               Disabled="_quickActionsBusy"
                               OnClick="ToggleAllBoostRooms">
                        @(AllBoostRoomsSelected ? "Clear" : "Select all")
                    </MudButton>
                </div>
                <div class="home-quick-chips">
                    @foreach (var room in _quickActionRooms)
                    {
                        var selected = _boostRoomNames.Contains(room.Name);
                        <MudChip T="string"
                                 Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                 Color="@(selected ? Color.Primary : Color.Default)"
                                 Icon="@(room.IsFavorite ? Icons.Material.Filled.Star : null)"
                                 IconColor="@(selected ? Color.Inherit : Color.Warning)"
                                 Disabled="_quickActionsBusy"
                                 OnClick="@(() => ToggleBoostRoom(room.Name))">
                            @room.Name
                        </MudChip>
                    }
                </div>

                @if (_boostPresets.Count > 0)
                {
                    <div class="home-quick-chips mt-2">
                        @foreach (var preset in _boostPresets)
                        {
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Variant="@(IsPresetSelected(preset) ? Variant.Filled : Variant.Outlined)"
                                     Color="Color.Secondary"
                                     Disabled="_quickActionsBusy"
                                     OnClick="@(() => SelectBoostPreset(preset))">
                                @($"{preset.Name} · {preset.TemperatureC:0.#}° · {FormatBoostDuration(preset.Minutes)}")
                            </MudChip>
                        }
                    </div>
                }

                <div class="home-boost-settings">
                    <div>
                        <span class="home-quick-label">Target</span>
                        <div class="home-temp-stepper">
                            <MudIconButton Icon="@Icons.Material.Filled.Remove"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="touch-target-icon"
                                           aria-label="Lower target by 0.5 °C"
                                           Disabled="@(_quickActionsBusy || QuickBoostTempClamped <= QuickBoostTempMin)"
                                           OnClick="@(() => StepQuickBoostTemp(-0.5))" />
                            <div class="home-temp-value" aria-live="polite">
                                @QuickBoostTempClamped.ToString("F1", CultureInfo.CurrentCulture)<span class="home-temp-unit">°C</span>
                            </div>
                            <MudIconButton Icon="@Icons.Material.Filled.Add"
                                           Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Class="touch-target-icon"
                                           aria-label="Raise target by 0.5 °C"
                                           Disabled="@(_quickActionsBusy || QuickBoostTempClamped >= QuickBoostTempMax)"
                                           OnClick="@(() => StepQuickBoostTemp(0.5))" />
                        </div>
                    </div>
                    <div>
                        <span class="home-quick-label">Duration</span>
                        <div class="home-duration-grid" role="radiogroup" aria-label="Boost duration">
                            @foreach (var m in QuickBoostDurationOptions)
                            {
                                var selected = _quickBoostMinutes == m;
                                <MudButton Variant="@(selected ? Variant.Filled : Variant.Outlined)"
                                           Color="Color.Primary"
                                           DropShadow="false"
                                           role="radio"
                                           aria-checked="@(selected ? "true" : "false")"
                                           aria-label="@FormatBoostDuration(m)"
                                           Disabled="_quickActionsBusy"
                                           OnClick="@(() => _quickBoostMinutes = m)">
                                    @FormatBoostDurationShort(m)
                                </MudButton>
                            }
                        </div>
                    </div>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           FullWidth="true"
                           StartIcon="@(_quickActionsBusy ? null : Icons.Material.Filled.Bolt)"
                           Class="touch-target mt-3"
                           Disabled="@(_quickActionsBusy || SelectedBoostRoomCount == 0)"
                           OnClick="ApplyQuickBoostAsync">
                    @if (_quickActionsBusy)
                    {
                        <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                    }
                    @QuickBoostButtonText
                </MudButton>
            </div>
        }

        <MudDivider Class="mt-4" />
        <div class="home-quick-secondary">
            <MudButton Variant="Variant.Outlined"
                       Color="@(AwayQuickActionShowsActive ? Color.Warning : Color.Primary)"
                       StartIcon="@(AwayQuickActionShowsActive ? Icons.Material.Filled.Home : Icons.Material.Filled.FlightTakeoff)"
                       Class="touch-target"
                       Disabled="@(_quickActionsBusy || _quickActionRooms.Count == 0)"
                       OnClick="@ToggleAwayModeAsync">
                @(AwayQuickActionShowsActive ? "Return home" : "Set away")
            </MudButton>
            <MudButton Href="/gas-meter"
                       Variant="Variant.Outlined"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.LocalGasStation"
                       Class="touch-target">
                Gas reading
            </MudButton>
        </div>
    </MudPaper>

    <MudPaper Class="pa-4 status-card">
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
            <MudText Typo="Typo.h6">
                <i class="fa-solid fa-grip"></i> Room temperatures &amp; trend
            </MudText>
            <MudButton Href="/charts"
                       Variant="Variant.Text"
                       Color="Color.Primary"
                       StartIcon="@Icons.Material.Filled.OpenInNew">
                Charts
            </MudButton>
        </MudStack>
        @if (_homeRoomTiles.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">No room trend data yet.</MudAlert>
        }
        else
        {
            <div class="room-heat-grid home-room-heat-grid mt-2">
                @foreach (var tile in _homeRoomTiles)
                {
                    <a class="room-heat-tile room-heat-link"
                       style="background-color:@tile.Color;"
                       href="@GetRoomDetailsHref(tile.Room)"
                       title="@($"Open {tile.Room} in Rooms")">
                        <div class="room-heat-name">
                            <span class="room-heat-state-square" style="background-color:@tile.CurrentStateColor;" title="@tile.CurrentStateText"></span>
                            @tile.Room
                        </div>
                        <div class="room-heat-temp">@tile.DisplayTemp</div>
                        <div class="room-heat-meta room-heat-meta-status">@tile.StatusText</div>
                        <div class="room-heat-meta d-none d-sm-block">@tile.TrendText</div>
                    </a>
                }
            </div>
        }
    </MudPaper>

    <MudExpansionPanels Class="home-expansion-panels">

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-map-location-dot"></i> Floorplan temperature overlay</MudText>
            </TitleContent>
            <ChildContent>
                <MudButton Href="/settings" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew" Class="mb-1 pa-0">
                    Configure in Settings
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Room pins are mapped in Settings. Colors reflect temperature vs each room's recommended range. A flame before the temperature means the room is calling for heat (hub demand). Icons after the temperature compare the latest reading to the previous poll (warmer, cooler, or steady).
                </MudText>
                @if (FloorplanImageHref is null)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        Upload a floorplan image and map room pins in Settings to enable this view.
                    </MudAlert>
                }
                else if (_homeFloorplanPins.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">
                        No room pins are mapped yet. Add pin coordinates in Settings.
                    </MudAlert>
                }
                else
                {
                    <div class="home-floorplan-wrap">
                        <img src="@FloorplanImageHref" alt="House floorplan" class="home-floorplan-image" />
                        @foreach (var pin in _homeFloorplanPins)
                        {
                            <a class="home-floorplan-pin"
                               href="@GetRoomDetailsHref(pin.Room)"
                               style="@($"left:{pin.XPercent:0.##}%;top:{pin.YPercent:0.##}%;--pin-color:{pin.Color};")"
                               title="@pin.Tooltip"
                               aria-label="@pin.Tooltip">
                                <span class="home-floorplan-pin-dot"></span>
                                <span class="home-floorplan-pin-label">
                                    <span class="home-floorplan-pin-room">@pin.Room</span><span class="home-floorplan-pin-sep">: </span>
                                    <span class="home-floorplan-pin-temp-group">
                                        @if (pin.CallingForHeat)
                                        {
                                            <i class="fa-solid fa-fire-flame-curved home-floorplan-pin-heat-icon" aria-hidden="true"></i>
                                        }
                                        <span class="home-floorplan-pin-temp">@pin.TempText</span>
                                        @if (pin.TrendIconClass is not null)
                                        {
                                            <i class="@pin.TrendIconClass home-floorplan-pin-trend-icon" aria-hidden="true"></i>
                                        }
                                    </span>
                                </span>
                            </a>
                        }
                    </div>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-cloud-sun"></i> Heating demand outlook</MudText>
            </TitleContent>
            <ChildContent>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Compares last 7 local days of HDD (from stored outdoor samples) to the next 7 days from Open-Meteo forecast daily temperatures. Same 15.5 °C base as the daily summary. Not a bill forecast.
                </MudText>
                @if (Options.OpenMeteoLat is null || Options.OpenMeteoLon is null)
                {
                    <MudText Typo="Typo.body2" Class="mud-text-secondary">
                        Configure Open-Meteo latitude and longitude on Settings to enable this outlook.
                    </MudText>
                }
                else if (_outlookLoading)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" Class="mt-1" />
                }
                else if (!string.IsNullOrWhiteSpace(_outlookError))
                {
                    <MudAlert Severity="Severity.Warning" Dense="true">@_outlookError</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.body1">@_outlookSummary</MudText>
                    @if (!string.IsNullOrWhiteSpace(_outlookDetail))
                    {
                        <MudText Typo="Typo.body2" Class="mt-1 mud-text-secondary">@_outlookDetail</MudText>
                    }
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-table"></i> Daily summary (energy proxies)</MudText>
            </TitleContent>
            <ChildContent>
                <MudButton Href="/charts" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.OpenInNew" Class="mb-1 pa-0">
                    Open Charts
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Per local day: HDD (15.5 °C base), mean outdoor °C, and heating demand / boiler relay minutes estimated from poll activity. Needs outdoor samples for HDD columns.
                </MudText>
                @if (_homeDailyRows.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No daily summary rows yet (needs recorded history).</MudAlert>
                }
                else
                {
                    <MudTable T="DailySummaryRow" Items="_homeDailyRows" Dense="true" Hover="true" Breakpoint="Breakpoint.Sm">
                        <HeaderContent>
                            <MudTh>Date</MudTh>
                            <MudTh Class="text-right">HDD</MudTh>
                            <MudTh Class="text-right">Avg out °C</MudTh>
                            <MudTh Class="text-right">Heat est. min</MudTh>
                            <MudTh Class="text-right">Relay est. min</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Date">@context.Date</MudTd>
                            <MudTd DataLabel="HDD" Class="text-right">@FmtOpt(context.Hdd)</MudTd>
                            <MudTd DataLabel="Avg out" Class="text-right">@FmtOpt(context.AvgOutdoorC)</MudTd>
                            <MudTd DataLabel="Heat min" Class="text-right">@FmtHeatMin(context.HeatingActiveEstimateMin)</MudTd>
                            <MudTd DataLabel="Relay min" Class="text-right">@FmtHeatMin(context.HeatingRelayEstimateMin)</MudTd>
                        </RowTemplate>
                    </MudTable>
                    <MudButton Href="/api/export/daily-summary.csv?days=14"
                               Variant="Variant.Text" Size="Size.Small" Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Download" Class="mt-1">
                        Export CSV (14 days)
                    </MudButton>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-piggy-bank"></i> Save on heating</MudText>
            </TitleContent>
            <ChildContent>
                <MudButton Href="/settings" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Tune" Class="mb-1 pa-0">
                    Customise routine
                </MudButton>
                <MudText Typo="Typo.caption" Class="mud-text-secondary d-block mb-2">
                    Suggestions are heuristics from your routine profile, recent heating activity, forecast context, and schedule mapping when hub data is available.
                </MudText>
                @if (_savingsSuggestions.Count == 0)
                {
                    <MudAlert Severity="Severity.Info" Dense="true">No suggestions yet.</MudAlert>
                }
                else
                {
                    <MudStack Spacing="1">
                        @foreach (var tip in _savingsSuggestions)
                        {
                            <MudAlert Severity="@(tip.Level == HeatingSavingsSuggestionLevel.Warning ? Severity.Warning : Severity.Info)" Dense="true">
                                <div class="d-flex flex-wrap align-center" style="gap: 10px;">
                                    <MudText Typo="Typo.body2" Class="flex-grow-1">
                                        <strong>@tip.Title:</strong> @tip.Body
                                    </MudText>
                                    <MudButton Href="@tip.ActionHref" Variant="Variant.Text" Size="Size.Small"
                                               Color="Color.Primary" EndIcon="@Icons.Material.Filled.OpenInNew">
                                        @tip.ActionText
                                    </MudButton>
                                </div>
                            </MudAlert>
                        }
                    </MudStack>
                }
            </ChildContent>
        </MudExpansionPanel>

        <MudExpansionPanel>
            <TitleContent>
                <MudText Typo="Typo.subtitle1"><i class="fa-solid fa-filter-circle-xmark"></i> Data quality (last 24h)</MudText>
            </TitleContent>
            <ChildContent>
                <MudStack Row="true" Wrap="Wrap.Wrap" Spacing="1" Class="mb-2">
                    <MudTooltip Text="Invalid hub readings not stored in history (last 24h).">
                        <MudChip T="string" Variant="Variant.Outlined" Color="Color.Warning">
                            Dropped invalid readings: @_qualityTotal24h
                        </MudChip>
                    </MudTooltip>
                    @foreach (var item in _qualityReasons24h)
                    {
                        <MudTooltip Text="Why samples were dropped.">
                            <MudChip T="string" Variant="Variant.Outlined" Color="Color.Info">
                                @($"{item.Reason}: {item.Count}")
                            </MudChip>
                        </MudTooltip>
                    }
                </MudStack>
                <MudButton Href="/charts#data-quality" Variant="Variant.Text" Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.OpenInNew">
                    View details
                </MudButton>
            </ChildContent>
        </MudExpansionPanel>

    </MudExpansionPanels>
</MudStack>

<div class="home-sticky-actionbar">
    <MudButton Variant="Variant.Filled"
               Color="Color.Primary"
               StartIcon="@Icons.Material.Filled.Bolt"
               Class="touch-target"
               Disabled="@(_quickActionsBusy || SelectedBoostRoomCount == 0)"
               OnClick="ApplyQuickBoostAsync">
        @($"Boost {FormatRoomCount(SelectedBoostRoomCount)}")
    </MudButton>
    <MudButton Variant="Variant.Outlined"
               Color="@(AwayQuickActionShowsActive ? Color.Warning : Color.Primary)"
               StartIcon="@(AwayQuickActionShowsActive ? Icons.Material.Filled.Home : Icons.Material.Filled.FlightTakeoff)"
               Class="touch-target"
               Disabled="@(_quickActionsBusy || _quickActionRooms.Count == 0)"
               OnClick="@ToggleAwayModeAsync">
        @(AwayQuickActionShowsActive ? "Return home" : "Set away")
    </MudButton>
</div>

@code {
