    private string FormatTimedAwayLocal(long unix)
    {
        var z = DisplayZone;
        var local = TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unix), z);
        return local.ToString("g", CultureInfo.CurrentCulture);
    }

    private string FormatTimedAwayBannerSummary(TimedAwaySessionRow session)
    {
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var localEnd = FormatTimedAwayLocal(session.EndsAtUnix);
        if (now >= session.EndsAtUnix)
        {
            var ago = TimeSpan.FromSeconds(now - session.EndsAtUnix);
            return $"ended {FormatTimedAwayRelative(ago)} ago ({localEnd}) — restoring Home on the hub";
        }

        var until = TimeSpan.FromSeconds(session.EndsAtUnix - now);
        return $"until {localEnd} ({FormatTimedAwayRelative(until)} left)";
    }

    private static string FormatTimedAwayRelative(TimeSpan span)
    {
        if (span.TotalMinutes < 1)
            return "under 1 min";
        if (span.TotalHours < 1)
            return $"{(int)Math.Round(span.TotalMinutes)} min";
        if (span.TotalDays < 1)
            return $"{span.Hours}h {span.Minutes}m";
        return $"{(int)span.TotalDays}d {span.Hours}h";
    }

    private async Task TryPromptExtendNearEndOnceAsync()
    {
        var s = Store.TryGetActiveTimedAwaySession();
        if (s is null)
            return;
        var policy = Store.GetTimedAwayPolicy();
        var now = DateTimeOffset.UtcNow.ToUnixTimeSeconds();
        var leadSec = Math.Max(1, policy.ExtensionLeadMinutes) * 60L;
        if (now < s.EndsAtUnix - leadSec || now >= s.EndsAtUnix)
            return;
        if (_extendPromptShownForSession == s.SessionId)
            return;
        _extendPromptShownForSession = s.SessionId;
        var endLocal = TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(s.EndsAtUnix), DisplayZone);
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Extend away mode?",
            $"Monitor away ends at {endLocal:g} ({DisplayZone.Id}). Add one hour?",
            yesText: "Extend 1 hour",
            cancelText: "Not now");
        if (confirm == true)
            await QuickExtendTimedAwayAsync(60);
    }

