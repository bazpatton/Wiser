    private void StepQuickAdjustDelta(double step) =>
        _quickAdjustDeltaC = Math.Clamp(
            Math.Round((_quickAdjustDeltaC + step) * 2, MidpointRounding.AwayFromZero) / 2,
            -QuickAdjustDeltaMax,
            QuickAdjustDeltaMax);

    /// <remarks>If-chain, not a relational switch: the .NET 9 Razor parser mis-reads some pattern lines as markup.</remarks>
    private static string FormatDelta(double delta)
    {
        var magnitude = Math.Abs(delta).ToString("F1", CultureInfo.CurrentCulture);
        if (Math.Abs(delta) < 0.01)
            return $"±{magnitude}";
        return delta > 0 ? $"+{magnitude}" : $"−{magnitude}";
    }

    private static int? MinutesUntilNextChange(QuickActionRoom room) =>
        TimedOverrideMath.MinutesUntilNextChange(room.NextScheduleChangeUnix, DateTimeOffset.UtcNow);

    /// <summary>One room's part of a quick action: the °C and minutes it gets, or why it was skipped.</summary>
    private sealed record QuickPlanItem(QuickActionRoom Room, double TempC, int Minutes, string? SkipReason);

    /// <summary>Works out each selected room's override; rooms the action can't apply to carry a skip reason.</summary>
    private List<QuickPlanItem> BuildQuickPlan()
    {
        var plan = new List<QuickPlanItem>();
        foreach (var room in _quickActionRooms.Where(r => _boostRoomNames.Contains(r.Name)))
        {
            double tempC;
            if (_quickAdjustMode)
            {
                if (room.TargetC is not { } target)
                {
                    plan.Add(new QuickPlanItem(room, 0, 0, "no current target"));
                    continue;
                }

                tempC = Math.Clamp(target + _quickAdjustDeltaC, QuickBoostTempMin, QuickBoostTempMax);
            }
            else
                tempC = QuickBoostTempClamped;

            int minutes;
            if (_quickBoostMinutes == QuickActionPresets.UntilNextChange)
            {
                if (MinutesUntilNextChange(room) is not { } untilNext)
                {
                    plan.Add(new QuickPlanItem(room, tempC, 0, $"no schedule change within {FormatBoostDuration(QuickActionPresets.MaxMinutes)}"));
                    continue;
                }

                minutes = untilNext;
            }
            else
                minutes = Math.Clamp(_quickBoostMinutes, QuickActionPresets.MinMinutes, QuickActionPresets.MaxMinutes);

            plan.Add(new QuickPlanItem(room, tempC, minutes, null));
        }

        return plan;
    }

