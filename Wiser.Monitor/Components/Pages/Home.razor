    /// <summary>Applies one ease-off preset to each room it fits; rooms without a target or schedule change are skipped.</summary>
    private async Task EaseOffRoomsAsync(IReadOnlyList<QuickActionRoom> rooms, EaseOffPreset preset)
    {
        var now = DateTimeOffset.UtcNow;
        var succeeded = new List<string>();
        var failed = new List<string>();
        var skipped = new List<string>();
        try
        {
            foreach (var room in rooms)
            {
                if (TimedOverrideMath.EaseOffTargetC(room.TargetC, preset) is not { } tempC
                    || TimedOverrideMath.EaseOffMinutes(room.NextScheduleChangeUnix, preset, now) is not { } minutes)
                {
                    skipped.Add(room.Name);
                    continue;
                }

                _heatingNowBusyRoomId = room.Id;
                StateHasChanged();
                try
                {
                    using var resp = await Http.PostAsJsonAsync("/api/room/boost", new
                    {
                        room_id = room.Id,
                        temperature_c = tempC,
                        minutes,
                    });
                    (resp.IsSuccessStatusCode ? succeeded : failed).Add(room.Name);
                }
                catch
                {
                    failed.Add(room.Name);
                }
            }

            var label = EaseOffShortLabel(rooms.Count == 1 ? rooms[0] : null, preset);
            var skippedNote = skipped.Count == 0 ? string.Empty : $" Skipped {string.Join(", ", skipped)} (target or next schedule change unknown).";
            if (failed.Count > 0)
                Snackbar.Add($"Ease off ({label}) failed for {string.Join(", ", failed)}.{skippedNote}", Severity.Warning);
            else if (succeeded.Count > 0)
                Snackbar.Add($"Eased off {string.Join(", ", succeeded)}: {label}, then back to schedule.{skippedNote}",
                    skipped.Count == 0 ? Severity.Success : Severity.Info);
            else
                Snackbar.Add($"Nothing eased off.{skippedNote}", Severity.Warning);

            if (succeeded.Count > 0)
            {
                await RefreshActiveBoostsAsync();
                BuildHomeRoomHeatMap();
                BuildHomeFloorplanOverlay();
            }
        }
        finally
        {
            _heatingNowBusyRoomId = null;
        }
    }

