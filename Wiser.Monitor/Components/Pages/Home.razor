    /// <summary>Quick-boost target snapped to 0.5 °C within hub limits.</summary>
    private double QuickBoostTempClamped =>
        Math.Clamp(Math.Round(_quickBoostTempC * 2, MidpointRounding.AwayFromZero) / 2, QuickBoostTempMin, QuickBoostTempMax);

    private void StepQuickBoostTemp(double delta) =>
        _quickBoostTempC = Math.Clamp(QuickBoostTempClamped + delta, QuickBoostTempMin, QuickBoostTempMax);

    /// <summary>Compact label for the duration buttons, e.g. "45m", "1½h", "2h".</summary>
    /// <remarks>No relational switch pattern here: the .NET 9 Razor parser reads a line starting with "&lt;" as markup.</remarks>
    private static string FormatBoostDurationShort(int minutes)
    {
        if (minutes >= 60 && minutes % 60 == 0)
            return $"{minutes / 60}h";
        if (minutes >= 60 && minutes % 60 == 30)
            return $"{minutes / 60}½h";
        return $"{minutes}m";
    }

    private static string FormatBoostDuration(int minutes)
    {
        if (minutes == QuickActionPresets.UntilNextChange)
            return "until next change";
        return minutes >= 60 && minutes % 60 == 0 ? (minutes == 60 ? "1 hour" : $"{minutes / 60} hours") : $"{minutes} mins";
    }

    private bool QuickApplyDisabled =>
        _quickActionsBusy || SelectedBoostRoomCount == 0 || (_quickAdjustMode && Math.Abs(_quickAdjustDeltaC) < 0.01);

    private async Task ApplyQuickBoostAsync()
    {
        if (_quickActionRooms.Count == 0)
            return;
        var plan = BuildQuickPlan();
        if (plan.Count == 0)
        {
            Snackbar.Add("Select at least one room.", Severity.Warning);
            return;
        }

        var toApply = plan.Where(static p => p.SkipReason is null).ToList();
        var skipped = plan.Where(static p => p.SkipReason is not null).ToList();
        if (toApply.Count == 0)
        {
            Snackbar.Add($"Nothing to apply: {string.Join("; ", skipped.Select(static p => $"{p.Room.Name} ({p.SkipReason})"))}.", Severity.Warning);
            return;
        }

        var verb = QuickApplyVerb;
        _quickActionsBusy = true;
        var succeeded = 0;
        var failed = 0;
        try
        {
            // Rooms differ in target and schedule, so send one batch per distinct (°C, minutes).
            foreach (var group in toApply.GroupBy(static p => (p.TempC, p.Minutes)))
            {
                var ids = group.Select(static p => p.Room.Id).Distinct().ToArray();
                try
                {
                    using var resp = await Http.PostAsJsonAsync("/api/rooms/boost", new
                    {
                        room_ids = ids,
                        temperature_c = group.Key.TempC,
                        minutes = group.Key.Minutes,
                    });
                    using var json = await JsonDocument.ParseAsync(await resp.Content.ReadAsStreamAsync());
                    var root = json.RootElement;
                    var groupOk = root.TryGetProperty("succeeded", out var sProp) ? sProp.GetInt32() : 0;
                    succeeded += groupOk;
                    failed += root.TryGetProperty("failed", out var fProp) ? fProp.GetInt32() : ids.Length - groupOk;
                }
                catch
                {
                    failed += ids.Length;
                }
            }

            var skippedNote = skipped.Count == 0
                ? string.Empty
                : $" Skipped {string.Join(", ", skipped.Select(static p => $"{p.Room.Name} ({p.SkipReason})"))}.";
            if (failed > 0)
            {
                Snackbar.Add($"{verb} completed with issues: {succeeded} succeeded, {failed} failed.{skippedNote}", Severity.Warning);
            }
            else
            {
                var change = _quickAdjustMode
                    ? $"{FormatDelta(_quickAdjustDeltaC)} °C"
                    : $"{QuickBoostTempClamped:F1} °C";
                var duration = _quickBoostMinutes == QuickActionPresets.UntilNextChange
                    ? "until each room's next schedule change"
                    : $"for {FormatBoostDuration(_quickBoostMinutes)}";
                Snackbar.Add($"{verb} applied to {FormatRoomCount(succeeded)}: {change} {duration}, then back to schedule.{skippedNote}",
                    skipped.Count == 0 ? Severity.Success : Severity.Info);
            }

            if (succeeded > 0)
            {
                await SaveQuickBoostSettingsAsync(QuickBoostTempClamped, _quickBoostMinutes);
                await RefreshActiveBoostsAsync();
            }
        }
        finally
        {
            _quickActionsBusy = false;
        }
    }

    /// <summary>Re-sends a running override at its current setpoint so it ends 30 minutes later.</summary>
    private async Task ExtendBoostAsync(ActiveBoost boost)
    {
        if (boost.SetpointC is not { } setpointC
            || TimedOverrideMath.ExtendMinutes(boost.EndUtc, DateTimeOffset.UtcNow) is not { } minutes)
            return;

        _cancelBoostBusyRoomId = boost.RoomId;
        try
        {
            using var resp = await Http.PostAsJsonAsync("/api/room/boost", new
            {
                room_id = boost.RoomId,
                temperature_c = setpointC,
                minutes,
            });
            if (resp.IsSuccessStatusCode)
                Snackbar.Add($"{boost.Name} extended until {FormatLocalTime(DateTimeOffset.UtcNow.AddMinutes(minutes))}.", Severity.Success);
            else
                Snackbar.Add($"Couldn't extend {boost.Name} (HTTP {(int)resp.StatusCode}).", Severity.Warning);
            await RefreshActiveBoostsAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Extend failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _cancelBoostBusyRoomId = null;
        }
    }

    private void PopulateActiveBoosts(HubLiveOverview overview)
    {
        _activeBoosts.Clear();
        foreach (var room in overview.Rooms)
        {
            if (room.Id <= 0 || RoomDisplayHelpers.GetActiveOverrideEndUtc(room) is not { } endUtc)
                continue;
            var targetC = room.SetpointC is { } sp ? WiserSetpointDisplay.ToDisplayTargetC(sp) : (double?)null;
            var isBoost = room.SetpointOrigin?.Contains("Boost", StringComparison.OrdinalIgnoreCase) == true;
            _activeBoosts.Add(new ActiveBoost(room.Id, room.Name, endUtc, targetC, isBoost, room.SetpointC));
        }

        _activeBoosts.Sort(static (a, b) => a.EndUtc.CompareTo(b.EndUtc));
    }

    /// <summary>Drops boosts whose end time passed since the last hub fetch, so the list never shows "0 min left".</summary>
    private List<ActiveBoost> ActiveBoostsNow()
    {
        var now = DateTimeOffset.UtcNow;
        return _activeBoosts.Where(b => b.EndUtc > now).ToList();
    }

    private string FormatActiveBoost(ActiveBoost boost)
    {
        var endLocal = TimeZoneInfo.ConvertTime(boost.EndUtc, DisplayZone).ToString("t", CultureInfo.CurrentCulture);
        var left = FormatTimedAwayRelative(boost.EndUtc - DateTimeOffset.UtcNow);
        var kind = boost.IsBoost ? "Boost" : "Override";
        var target = boost.SetpointC is { } raw && WiserSetpointDisplay.IsHubOffSentinel(raw)
            ? " heating off"
            : boost.TargetC is { } t ? $" {t:F1} °C" : string.Empty;
        return $"{kind}{target} · until {endLocal} · {left} left";
    }

    /// <summary>Re-reads the hub so the active-boost list reflects a boost or cancel just made.</summary>
    private async Task RefreshActiveBoostsAsync()
    {
        try
        {
            var overview = await LiveHubRoomTemps.TryFetchOverviewAsync(Hub, Options, CancellationToken.None);
            if (overview is null)
                return;
            RoomsCache.Update(overview);
            _liveDataAt = DateTimeOffset.Now;
            _liveHubByRoom = LiveHubRoomTemps.ToAvailableTempByRoomName(overview);
            PopulateQuickActionRooms(overview, resetSelection: false);
        }
        catch
        {
            // the 45s refresh will catch up
        }
    }

    private async Task CancelBoostsAsync(IReadOnlyList<ActiveBoost> boosts)
    {
        if (boosts.Count == 0)
            return;

        var succeeded = 0;
        var failed = 0;
        try
        {
            foreach (var boost in boosts)
            {
                _cancelBoostBusyRoomId = boost.RoomId;
                try
                {
                    using var resp = await Http.PostAsJsonAsync("/api/room/cancel-override", new { room_id = boost.RoomId });
                    if (resp.IsSuccessStatusCode)
                        succeeded++;
                    else
                        failed++;
                }
                catch
                {
                    failed++;
                }
            }

            if (failed > 0)
                Snackbar.Add($"Cancel boost completed with issues: {succeeded} succeeded, {failed} failed.", Severity.Warning);
            else if (boosts.Count == 1)
                Snackbar.Add($"Boost cancelled for {boosts[0].Name}; room is back on schedule.", Severity.Success);
            else
                Snackbar.Add($"Boost cancelled for {succeeded} rooms; back on schedule.", Severity.Success);

            await RefreshActiveBoostsAsync();
            BuildHomeRoomHeatMap();
            BuildHomeFloorplanOverlay();
        }
        finally
        {
            _cancelBoostBusyRoomId = null;
        }
    }

    private bool IsPresetSelected(BoostPresetInfo preset) =>
        !_quickAdjustMode
        && Math.Abs(QuickBoostTempClamped - preset.TemperatureC) < 0.01
        && _quickBoostMinutes == preset.Minutes;

    private void SelectBoostPreset(BoostPresetInfo preset)
    {
        _quickAdjustMode = false;
        _quickBoostTempC = preset.TemperatureC;
        // Presets are editable, so their minutes may not match a duration button; the apply button still shows them.
        _quickBoostMinutes = preset.Minutes;
    }

    private static bool IsValidQuickMinutes(int minutes) =>
        minutes == QuickActionPresets.UntilNextChange
        || minutes is >= QuickActionPresets.MinMinutes and <= QuickActionPresets.MaxMinutes;

    /// <summary>Restores the last applied quick-boost target and duration; returns true when anything changed.</summary>
    private async Task<bool> TryLoadQuickBoostSettingsAsync()
    {
        try
        {
            var changed = false;
            var tempRaw = await Js.InvokeAsync<string?>("localStorage.getItem", QuickBoostTempStorageKey);
            if (double.TryParse(tempRaw, NumberStyles.Float, CultureInfo.InvariantCulture, out var temp)
                && temp is >= QuickBoostTempMin and <= QuickBoostTempMax)
            {
                _quickBoostTempC = temp;
                changed = true;
            }

            var minutesRaw = await Js.InvokeAsync<string?>("localStorage.getItem", QuickBoostMinutesStorageKey);
            if (int.TryParse(minutesRaw, NumberStyles.Integer, CultureInfo.InvariantCulture, out var minutes)
                && IsValidQuickMinutes(minutes))
            {
                _quickBoostMinutes = minutes;
                changed = true;
            }

            var modeRaw = await Js.InvokeAsync<string?>("localStorage.getItem", QuickAdjustModeStorageKey);
            if (modeRaw is "1")
            {
                _quickAdjustMode = true;
                changed = true;
            }

            var deltaRaw = await Js.InvokeAsync<string?>("localStorage.getItem", QuickAdjustDeltaStorageKey);
            if (double.TryParse(deltaRaw, NumberStyles.Float, CultureInfo.InvariantCulture, out var delta)
                && Math.Abs(delta) is >= 0.5 and <= QuickAdjustDeltaMax)
            {
                _quickAdjustDeltaC = delta;
                changed = true;
            }

            return changed;
        }
        catch
        {
            return false;
        }
    }

    private async Task SaveQuickBoostSettingsAsync(double tempC, int minutes)
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", QuickBoostTempStorageKey, tempC.ToString(CultureInfo.InvariantCulture));
            await Js.InvokeVoidAsync("localStorage.setItem", QuickBoostMinutesStorageKey, minutes.ToString(CultureInfo.InvariantCulture));
            await Js.InvokeVoidAsync("localStorage.setItem", QuickAdjustModeStorageKey, _quickAdjustMode ? "1" : "0");
            await Js.InvokeVoidAsync("localStorage.setItem", QuickAdjustDeltaStorageKey, _quickAdjustDeltaC.ToString(CultureInfo.InvariantCulture));
        }
        catch
        {
            // best effort
        }
    }

    private async Task ToggleAwayModeAsync()
    {
        if (!AwayQuickActionShowsActive)
        {
            await SetTimedAwayFromPromptAsync();
            return;
        }

        _quickActionsBusy = true;
        try
        {
            var hadHubAway = _hubSystemAway;
            if (_hubSystemAway)
            {
                await Hub.PatchSystemHomeAwayAsync(Options, "HOME", null, CancellationToken.None).ConfigureAwait(false);
                var refreshed = await LiveHubRoomTemps.TryFetchOverviewAsync(Hub, Options, CancellationToken.None).ConfigureAwait(false);
                if (refreshed is not null)
                {
                    RoomsCache.Update(refreshed);
                    _hubSystemAway = refreshed.SystemAway;
                }
                else
                    _hubSystemAway = false;

                if (hadHubAway && !_hubSystemAway)
                    Snackbar.Add("Whole-house away cleared on the hub.", Severity.Success);
            }

            if (_awayModeActive || _awayModeSnapshot.Count > 0)
                await UnsetSavedQuickActionAwayAsync();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Could not update away mode: {ex.Message}", Severity.Error);
        }
        finally
        {
            _quickActionsBusy = false;
        }
    }

    private async Task SetTimedAwayFromPromptAsync()
    {
        if (!HubConfiguredForApi)
        {
            Snackbar.Add("Hub API is not configured.", Severity.Warning);
            return;
        }

        var parms = new DialogParameters<AwayEndDateTimeDialog>
        {
            { x => x.InitialDate, _awayPromptEndDate },
            { x => x.InitialTime, _awayPromptEndTime },
            { x => x.Zone, DisplayZone },
        };
        var dialog = await DialogService.ShowAsync<AwayEndDateTimeDialog>("Set away mode until", parms);
        var result = await dialog.Result;
        if (result is null || result.Canceled || result.Data is not DateTime localUnspecified)
            return;

        _awayPromptEndDate = localUnspecified.Date;
        _awayPromptEndTime = localUnspecified.TimeOfDay;
        await ScheduleAwayUntilAsync(localUnspecified);
    }

    private async Task ScheduleAwayUntilAsync(DateTime localUnspecified)
    {
        var utc = TimeZoneInfo.ConvertTimeToUtc(localUnspecified, DisplayZone);
        var unix = new DateTimeOffset(utc, TimeSpan.Zero).ToUnixTimeSeconds();

        _quickActionsBusy = true;
        try
        {
            using var resp = await Http.PostAsJsonAsync("/api/away/schedule", new
            {
                ends_at_unix = unix,
                temperature_c = Store.GetTimedAwayPolicy().AwayLimitC,
            });
            if (!resp.IsSuccessStatusCode)
            {
                Snackbar.Add($"Away mode failed: {await resp.Content.ReadAsStringAsync()}", Severity.Error);
                return;
            }

            var refreshed = await LiveHubRoomTemps.TryFetchOverviewAsync(Hub, Options, CancellationToken.None).ConfigureAwait(false);
            if (refreshed is not null)
            {
                RoomsCache.Update(refreshed);
                _hubSystemAway = refreshed.SystemAway;
            }
            else
            {
                _hubSystemAway = true;
            }

            _awayModeActive = false;
            _awayModeSnapshot.Clear();
            await ClearAwayStateAsync();

            var localEnds = TimeZoneInfo.ConvertTime(DateTimeOffset.FromUnixTimeSeconds(unix), DisplayZone);
            Snackbar.Add(
                $"Away mode set until {localEnds.ToString("g", CultureInfo.CurrentCulture)} ({DisplayZone.Id}).",
                Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Away mode failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _quickActionsBusy = false;
        }
    }

    private async Task SetAwayModeAutoAsync()
    {
        if (_quickActionRooms.Count == 0)
            return;

        _awayModeSnapshot.Clear();
        _awayModeSnapshot.AddRange(_quickActionRooms.Select(static r =>
            new AwayRoomSnapshot(r.Id, r.ModeKey, r.ModeKey == "manual" ? r.ManualTemperatureC : null)));
        var roomIds = _quickActionRooms.Select(static r => r.Id).Distinct().ToArray();
        _quickActionsBusy = true;
        try
        {
            using var resp = await Http.PostAsJsonAsync("/api/rooms/mode", new
            {
                room_ids = roomIds,
                mode = "auto",
                temperature_c = (double?)null,
            });
            using var json = await JsonDocument.ParseAsync(await resp.Content.ReadAsStreamAsync());
            var root = json.RootElement;
            var ok = root.TryGetProperty("ok", out var okProp) && okProp.GetBoolean();
            var succeeded = root.TryGetProperty("succeeded", out var sProp) ? sProp.GetInt32() : 0;
            var failed = root.TryGetProperty("failed", out var fProp) ? fProp.GetInt32() : roomIds.Length - succeeded;
            if (!resp.IsSuccessStatusCode || !ok)
            {
                Snackbar.Add($"Away mode completed with issues: {succeeded} succeeded, {failed} failed.", Severity.Warning);
            }
            else
            {
                _awayModeActive = true;
                await PersistAwayStateAsync();
                Snackbar.Add($"Away mode set to Auto for {succeeded} room(s).", Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Away mode failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _quickActionsBusy = false;
        }
    }

    private async Task UnsetSavedQuickActionAwayAsync()
    {
        if (_awayModeSnapshot.Count == 0)
        {
            _awayModeActive = false;
            await ClearAwayStateAsync();
            Snackbar.Add("Away mode snapshot was not found. Cleared saved away state.", Severity.Info);
            return;
        }

        var succeeded = 0;
        var failed = 0;
        foreach (var room in _awayModeSnapshot)
        {
            try
            {
                using var resp = await Http.PostAsJsonAsync("/api/room/mode", new
                {
                    room_id = room.RoomId,
                    mode = room.Mode,
                    temperature_c = room.ManualTemperatureC,
                });
                if (resp.IsSuccessStatusCode)
                    succeeded++;
                else
                    failed++;
            }
            catch
            {
                failed++;
            }
        }

        if (failed > 0)
        {
            Snackbar.Add($"Unset away mode completed with issues: {succeeded} succeeded, {failed} failed.", Severity.Warning);
            return;
        }

        _awayModeActive = false;
        _awayModeSnapshot.Clear();
        await ClearAwayStateAsync();
        Snackbar.Add("Away mode unset and prior room modes restored.", Severity.Success);
    }

    private async Task TryLoadAwayStateAsync()
    {
        try
        {
            var activeRaw = await Js.InvokeAsync<string?>("localStorage.getItem", AwayModeActiveStorageKey);
            _awayModeActive = activeRaw == "1";
            var snapshotRaw = await Js.InvokeAsync<string?>("localStorage.getItem", AwayModeSnapshotStorageKey);
            if (!string.IsNullOrWhiteSpace(snapshotRaw))
            {
                var parsed = JsonSerializer.Deserialize<List<AwayRoomSnapshot>>(snapshotRaw);
                _awayModeSnapshot.Clear();
                if (parsed is not null)
                    _awayModeSnapshot.AddRange(parsed.Where(static x => x.RoomId > 0));
            }
        }
        catch
        {
            _awayModeActive = false;
            _awayModeSnapshot.Clear();
        }
    }

    private async Task PersistAwayStateAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", AwayModeActiveStorageKey, _awayModeActive ? "1" : "0");
            var json = JsonSerializer.Serialize(_awayModeSnapshot);
            await Js.InvokeVoidAsync("localStorage.setItem", AwayModeSnapshotStorageKey, json);
        }
        catch
        {
            // best effort
        }
    }

    private async Task ClearAwayStateAsync()
    {
        try
        {
            await Js.InvokeVoidAsync("localStorage.setItem", AwayModeActiveStorageKey, "0");
            await Js.InvokeVoidAsync("localStorage.removeItem", AwayModeSnapshotStorageKey);
        }
        catch
        {
            // best effort
        }
    }

    private IReadOnlyList<string> GetHomeTrendRoomNames()
    {
        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var r in Store.ListRooms())
            names.Add(r);
        if (_liveHubByRoom is not null)
        {
            foreach (var r in _liveHubByRoom.Keys)
            {
                var stored = Store.ResolveStoredRoomName(r);
                names.Add(stored ?? r);
            }
        }
        else
        {
            foreach (var r in MonitorState.GetLastRooms())
            {
                var stored = Store.ResolveStoredRoomName(r);
                names.Add(stored ?? r);
            }
        }

        return names.OrderBy(static x => x, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private bool TryGetLiveTempC(string room, out double tempC)
    {
        tempC = 0;
        if (_liveHubByRoom is null
            || !_liveHubByRoom.TryGetValue(room, out var live)
            || LiveHubRoomTemps.IsUnavailableTemp(live.TempC))
            return false;

        tempC = live.TempC;
        return true;
    }

    private void BuildHomeRoomHeatMap()
    {
        _homeTrendBuildError = null;
        _homeRoomTiles.Clear();
        _lastTwoTempsByRoom.Clear();
        var rooms = GetHomeTrendRoomNames();
        if (rooms.Count == 0)
            return;

        var sinceTs = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - (HomeTrendHours * 3600L);
        var activityMap = Store.GetRoomActivityMap();
        var (ignoreStart, ignoreEnd) = Store.GetTrendIgnoreWindow();

        var tiles = new List<HomeRoomHeatTile>(rooms.Count);
        foreach (var room in rooms)
        {
            var isActive = !activityMap.TryGetValue(room, out var activeFlag) || activeFlag;
            var rows = Store.SeriesRoom(room, sinceTs);
            if (rows.Count >= 2)
                _lastTwoTempsByRoom[room] = (rows[^2].TempC, rows[^1].TempC);
            if (rows.Count == 0)
            {
                var (missingMin, missingMax) = GetRecommendedTempRange(room, isActive);
                var hasLive = TryGetLiveTempC(room, out var liveOnlyTemp);
                var bandColor = hasLive
                    ? ComfortColors.GetGradientColor(liveOnlyTemp, missingMin, missingMax)
                    : "#334155";
                var (cst, csc) = hasLive
                    ? ComfortColors.GetCurrentState(liveOnlyTemp, missingMin, missingMax)
                    : ("Current state unavailable", "#94a3b8");
                tiles.Add(new HomeRoomHeatTile(
                    room,
                    hasLive ? liveOnlyTemp : null,
                    hasLive ? $"{liveOnlyTemp:0.0}C" : "—",
                    bandColor,
                    $"Recommended {missingMin:0.#} - {missingMax:0.#}C",
                    hasLive
                        ? "Live hub temperature (no stored history in last 24h)"
                        : $"No data in selected period{(isActive ? string.Empty : ", inactive profile")}",
                    hasLive ? "Trend building" : "Trend unavailable",
                    null,
                    -1,
                    0,
                    0,
                    cst,
                    csc));
                continue;
            }

            var storedCurrent = rows[^1].TempC;
            var displayTemp = ResolveDisplayTempC(room, storedCurrent);
            var trendRows = rows
                .Where(x => !IsWithinIgnoreWindow(x.Ts, ignoreStart, ignoreEnd, DisplayZone))
                .ToList();
            if (trendRows.Count == 0)
            {
                var (missingMin, missingMax) = GetRecommendedTempRange(room, isActive);
                var bandColor = ComfortColors.GetGradientColor(displayTemp, missingMin, missingMax);
                var (cst, csc) = ComfortColors.GetCurrentState(displayTemp, missingMin, missingMax);
                tiles.Add(new HomeRoomHeatTile(
                    room,
                    displayTemp,
                    $"{displayTemp:0.0}C",
                    bandColor,
                    $"Recommended {missingMin:0.#} - {missingMax:0.#}C",
                    $"No trend data outside ignored window{(isActive ? string.Empty : ", inactive profile")}",
                    $"Ignored {ignoreStart:hh\\:mm}-{ignoreEnd:hh\\:mm}",
                    null,
                    -1,
                    0,
                    0,
                    cst,
                    csc));
                continue;
            }

            var average = trendRows.Average(static x => x.TempC);
            var trendDelta = trendRows[^1].TempC - trendRows[0].TempC;
            var (rangeMin, rangeMax) = GetRecommendedTempRange(room, isActive);
            var status = average < rangeMin
                ? "Too cold"
                : average > rangeMax
                    ? "Too hot"
                    : "In range";
            var statusRank = status switch
            {
                "Too hot" => 2,
                "In range" => 1,
                _ => 0,
            };
            var severity = status switch
            {
                "Too hot" => average - rangeMax,
                "Too cold" => rangeMin - average,
                _ => Math.Abs(average - ((rangeMin + rangeMax) / 2.0)),
            };
            // Too cold: ascending sort key (smallest gap below range first — closest to OK). Too hot / in range: negate so OrderBy puts larger severity first.
            var sortKeyWithinBand = status == "Too cold" ? severity : -severity;
            // Tile colour matches the shown °C (live hub when available), not the 24h average — avoids mismatch with the Rooms page.
            var color = ComfortColors.GetGradientColor(displayTemp, rangeMin, rangeMax);
            var (currentStateText, currentStateColor) = ComfortColors.GetCurrentState(displayTemp, rangeMin, rangeMax);
            tiles.Add(new HomeRoomHeatTile(
                room,
                displayTemp,
                $"{displayTemp:0.0}C",
                color,
                $"Recommended {rangeMin:0.#} - {rangeMax:0.#}C",
                $"{status} (avg {average:0.0}C over {HomeTrendHours}h){(isActive ? string.Empty : ", inactive profile")}",
                $"Trend {FormatTrend(trendDelta)}",
                trendDelta,
                statusRank,
                severity,
                sortKeyWithinBand,
                currentStateText,
                currentStateColor));
        }

        _homeRoomTiles.AddRange(tiles
            .OrderByDescending(static x => x.StatusRank)
            .ThenBy(static x => x.SortKeyWithinBand)
            .ThenByDescending(static x => x.TrendDeltaC.HasValue)
            .ThenByDescending(static x => x.TrendDeltaC)
            .ThenBy(static x => RoomDisplayPriority.KindOrder(x.Room))
            .ThenBy(static x => x.Room, StringComparer.OrdinalIgnoreCase));
    }

    private double ResolveDisplayTempC(string room, double storedTempC)
    {
        if (_liveHubByRoom is not null
            && _liveHubByRoom.TryGetValue(room, out var live)
            && !LiveHubRoomTemps.IsUnavailableTemp(live.TempC))
            return live.TempC;
        return storedTempC;
    }

    private bool ResolveCallingForHeat(string room, LatestDto latestDb)
    {
        if (_liveHubByRoom is not null && _liveHubByRoom.TryGetValue(room, out var live))
            return live.HeatDemand != 0 || (live.PercentageDemand ?? 0) > 0;
        return latestDb.CallingForHeat;
    }

    private void BuildHomeFloorplanOverlay()
    {
        _homeFloorplanPins.Clear();
        _homeFloorplanConfig = Store.GetFloorplanConfig();
        if (_homeFloorplanConfig.Pins.Count == 0)
            return;

        var latestByRoom = Store.LatestByRoom();
        var activityMap = Store.GetRoomActivityMap();

        foreach (var pin in _homeFloorplanConfig.Pins)
        {
            var room = pin.Room.Trim();
            if (room.Length == 0)
                continue;

            if (!latestByRoom.TryGetValue(room, out var latest))
            {
                _homeFloorplanPins.Add(new HomeFloorplanPin(
                    room,
                    Math.Clamp(pin.XPercent, 0, 100),
                    Math.Clamp(pin.YPercent, 0, 100),
                    "#64748b",
                    "—",
                    null,
                    false,
                    $"{room}: no current reading"));
                continue;
            }

            var isActive = !activityMap.TryGetValue(room, out var activeFlag) || activeFlag;
            var (rangeMin, rangeMax) = GetRecommendedTempRange(room, isActive);
            var displayTemp = ResolveDisplayTempC(room, latest.TempC);
            var color = ComfortColors.GetGradientColor(displayTemp, rangeMin, rangeMax);
            var tempText = $"{displayTemp:0.0}C";
            var callingHeat = ResolveCallingForHeat(room, latest);
            var tooltip =
                $"{room}: {displayTemp:0.0}C. Recommended {rangeMin:0.#}-{rangeMax:0.#}C"
                + (isActive ? string.Empty : " (inactive profile)")
                + (callingHeat ? " · Calling for heat" : string.Empty);

            string? trendIcon = null;
            if (TryGetRoomPollTrendDelta(room, out var trendDelta))
            {
                trendIcon = TrendIconClassForDelta(trendDelta, FloorplanPollTrendDeadbandC);
                tooltip += $" · {FormatPollTrendTooltip(trendDelta)}";
            }

            _homeFloorplanPins.Add(new HomeFloorplanPin(
                room,
                Math.Clamp(pin.XPercent, 0, 100),
                Math.Clamp(pin.YPercent, 0, 100),
                color,
                tempText,
                trendIcon,
                callingHeat,
                tooltip));
        }
    }

    /// <summary>Minimum |Δ°C| between consecutive polls to show up/down icon (below = steady).</summary>
    private const double FloorplanPollTrendDeadbandC = 0.15;

    private bool TryGetRoomPollTrendDelta(string room, out double trendDelta)
    {
        trendDelta = 0;
        // Heat map already loaded this room's 24h series; reuse its last two polls.
        if (_lastTwoTempsByRoom.TryGetValue(room, out var cached))
        {
            trendDelta = cached.Last - cached.Prev;
            return true;
        }

        // Pin room not on the heat map (e.g. name mismatch): fetch only the two newest rows.
        var lookbackSec = Math.Max(HomeTrendHours * 3600L, Options.IntervalSec * 4L);
        var sinceTs = DateTimeOffset.UtcNow.ToUnixTimeSeconds() - lookbackSec;
        var recent = Store.RecentRoomTemps(room, sinceTs, 2);
        if (recent.Count < 2)
            return false;

        trendDelta = recent[0] - recent[1];
        return true;
    }

    private static string TrendIconClassForDelta(double trendDelta, double deadbandC)
    {
        if (trendDelta > deadbandC)
            return "fa-solid fa-arrow-trend-up";
        if (trendDelta < -deadbandC)
            return "fa-solid fa-arrow-trend-down";
        return "fa-solid fa-minus";
    }

    private static string FormatPollTrendTooltip(double trendDelta)
    {
        if (trendDelta > FloorplanPollTrendDeadbandC)
            return $"warmer than prior read (+{trendDelta:0.0} °C)";
        if (trendDelta < -FloorplanPollTrendDeadbandC)
            return $"cooler than prior read ({trendDelta:0.0} °C)";
        return Math.Abs(trendDelta) < 0.05
            ? "same as prior read"
            : $"steady vs prior read ({trendDelta:+0.0;-0.0;0.0} °C)";
    }

    private Dictionary<string, (double Min, double Max)> _roomRanges = new(StringComparer.OrdinalIgnoreCase);

    private (double Min, double Max) GetRecommendedTempRange(string roomName, bool isActive) =>
        RoomDisplayHelpers.GetRecommendedTempRange(roomName, isActive, _roomRanges);

    private static string FormatTrend(double trendDelta) =>
        RoomDisplayHelpers.FormatTrend(trendDelta);

    private static bool IsWithinIgnoreWindow(long timestampUtc, TimeSpan ignoreStart, TimeSpan ignoreEnd, TimeZoneInfo zone) =>
        RoomDisplayHelpers.IsWithinIgnoreWindow(timestampUtc, ignoreStart, ignoreEnd, zone);

    private static string GetRoomDetailsHref(string roomName) =>
        RoomDisplayHelpers.GetRoomDetailsHref(roomName);

    private sealed record HomeRoomHeatTile(
        string Room,
        double? TempC,
        string DisplayTemp,
        string Color,
        string RangeText,
        string StatusText,
        string TrendText,
        double? TrendDeltaC,
        int StatusRank,
        double Severity,
        double SortKeyWithinBand,
        string CurrentStateText,
        string CurrentStateColor);

    private sealed record HomeFloorplanPin(
        string Room,
        double XPercent,
        double YPercent,
        string Color,
        string TempText,
        string? TrendIconClass,
        bool CallingForHeat,
        string Tooltip);

    private static string ResolveModeKey(string? mode, double? setpointC)
    {
        if (string.Equals(mode, "Auto", StringComparison.OrdinalIgnoreCase))
            return "auto";
        if (setpointC is double sp && sp < 5.0)
            return "off";
        return "manual";
    }

    private sealed record QuickActionRoom(
        int Id,
        string Name,
        bool IsFavorite,
        string ModeKey,
        double? ManualTemperatureC,
        double? TempC,
        double? TargetC,
        bool CallingHeat,
        long? NextScheduleChangeUnix);
    private sealed record AwayRoomSnapshot(int RoomId, string Mode, double? ManualTemperatureC);
    /// <param name="SetpointC">Raw hub setpoint (off sentinel kept) so an extension re-sends exactly the same override.</param>
    private sealed record ActiveBoost(int RoomId, string Name, DateTimeOffset EndUtc, double? TargetC, bool IsBoost, double? SetpointC);
}

